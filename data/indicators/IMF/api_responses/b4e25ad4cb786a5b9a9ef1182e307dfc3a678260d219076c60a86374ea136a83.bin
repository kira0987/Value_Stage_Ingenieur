100,000 and more","max":"1500000"},{"max":"100000","min":"50000","color":"#d48639","label":"50,000 to 100,000"},{"max":"50000","label":"0 to 50,000","color":"#e1a365","min":"0"},{"label":"-50,000 to 0","color":"#B7CCA3","min":"-50000","max":"0"},{"label":"-200,000 to -50,000","min":"-200000","max":"-50000","color":"#97AF7D"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"unit":"Millions of US Dollars","datasource":"\/external\/datamapper\/api\/index.php?values=DebtL","label":"Debt Securities Liabilities","mapinfo":"EN","source":"Capital Flows in Developing Economies","stackable":"0"},"OtherGov":{"dataset":"CF","group":"4","legend":[{"color":"#cc660b","min":"250000","label":"250,000 and more","max":"550000"},{"max":"250000","color":"#d48639","min":"50000","label":"50,000 to 250,000"},{"label":"0 to 50,000","min":"0","max":"50000","color":"#e1a365"},{"label":"-50,000 to 0","color":"#B7CCA3","max":"0","min":"-50000"},{"color":"#97AF7D","min":"-250000","max":"-50000","label":"-250,000 to -50,000"},{"max":"0","label":"no data","min":"0","color":"#d5d7da"}],"mapinfo":"EN","label":"Proxy for Official Other Investment Liabilities","datasource":"\/external\/datamapper\/api\/index.php?values=OtherGov","stackable":"0","unit":"Millions of US Dollars","source":"Capital Flows in Developing Economies"},"OtherA":{"group":"4","dataset":"CF","legend":[{"max":"1500000","min":"500000","color":"#cc660b","label":"500,000 and more"},{"color":"#d48639","max":"500000","label":"100,000 to 500,000","min":"100000"},{"label":"0 to 100,000","color":"#e1a365","min":"0","max":"100000"},{"label":"-500,000 to 0","color":"#B7CCA3","min":"-500000","max":"0"},{"color":"#97AF7D","label":"-1.5m to -500,000","min":"-1500000","max":"-500000"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"label":"Other Investment Assets","unit":"Millions of US Dollars","datasource":"\/external\/datamapper\/api\/index.php?values=OtherA","mapinfo":"EN","source":"Capital Flows in Developing Economies","stackable":"0"},"OtherL":{"dataset":"CF","group":"4","stackable":"0","source":"Capital Flows in Developing Economies","legend":[{"max":"2000000","label":"500,000 and more","color":"#cc660b","min":"500000"},{"label":"100,000 to 500,000","max":"500000","color":"#d48639","min":"100000"},{"max":"100000","color":"#e1a365","label":"0 to 100,000","min":"0"},{"max":"0","label":"-500,000 to 0","color":"#B7CCA3","min":"-500000"},{"label":"-1.5m to -500,000","min":"-1500000","color":"#97AF7D","max":"-500000"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"label":"Other Investment Liabilities","datasource":"\/external\/datamapper\/api\/index.php?values=OtherL","mapinfo":"EN","unit":"Millions of US Dollars"},"Deriv":{"group":"5","dataset":"CF","legend":[{"label":"100,000 and more","max":"250000","min":"100000","color":"#cc660b"},{"min":"50000","color":"#d48639","max":"100000","label":"50,000 to 100,000"},{"label":"0 to 50,000","color":"#e1a365","max":"50000","min":"0"},{"color":"#B7CCA3","label":"-50,000 to 0","min":"-50000","max":"0"},{"max":"-50000","label":"-60,000 to -50,000","min":"-60000","color":"#97AF7D"},{"label":"no data","min":"0","color":"#d5d7da","max":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=Deriv","source":"Capital Flows in Developing Economies","label":"Financial Derivatives","mapinfo":"EN","unit":"Millions of US Dollars","stackable":"0"},"DebtForg":{"group":"5","dataset":"CF","legend":[{"color":"#cc660b","label":"5,000 or more","max":"50000","min":"5000"},{"max":"5000","min":"4000","color":"#d48639","label":"4,000 - 5,000"},{"max":"4000","color":"#e1a365","label":"2,000 - 4,000","min":"2000"},{"max":"2000","label":"0 - 2,000","min":"0","color":"#B7CCA3"},{"color":"#97AF7D","max":"0","min":"-15000","label":"Less than 0"},{"max":"0","min":"0","label":"no data","color":"#d5d7da"}],"unit":"Millions of US Dollars","label":"Debt Forgiveness","mapinfo":"EN","stackable":"0","datasource":"\/external\/datamapper\/api\/index.php?values=DebtForg","source":"Capital Flows in Developing Economies"},"GDP":{"group":"5","dataset":"CF","unit":"Millions of US Dollars","datasource":"\/external\/datamapper\/api\/index.php?values=GDP","label":"Nominal GDP","source":"Capital Flows in Developing Economies","mapinfo":"EN","legend":[{"color":"#cc660b","label":"10 m and more","max":"25000000","min":"10000000"},{"color":"#d48639","min":"1000000","max":"10000000","label":"1 m to 10 m"},{"color":"#e1a365","label":"500,000 to 1 m","max":"1000000","min":"500000"},{"label":"-1,000 to 500,000","min":"1000","color":"#B7CCA3","max":"500000"},{"label":"Less than 1,000","max":"1000","color":"#97AF7D","min":"0"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"stackable":"0"},"ka_new":{"group":"1","dataset":"CL","decimalrounding":"2","unit":"Units","datasource":"\/external\/datamapper\/api\/index.php?values=ka_new","legend":[{"color":"#1e75b2","label":"0.8 - 1","min":"0.8","max":"1.5"},{"min":"0.6","color":"#9dbdce","label":"0.6 - 0.8","max":"0.8"},{"label":"0.4 - 0.6","color":"#d3bdba","max":"0.6","min":"0.4"},{"label":"0.2 - 0.4","max":"0.4","color":"#f78b7e","min":"0.2"},{"max":"0.2","min":"0","label":"under 0.2","color":"#d52a25"},{"color":"#d5d7da","max":"0","min":"0","label":"no data"}],"description":"Overall Openness Index is the unweighted average of the openness of twelve types of  asset categories: equity, bond, money market, collective investment, derivates and other instruments, commercial credit, financial credit, direct investment, direct investment liquidation, guarantees, real estate and personal capital transaction. Range between 0 to 1 (1 indicates fully liberalized).","source":"Wang-Jahan Index","mapinfo":"EN","label":"Overall Openness Index (all asset categories)","stackable":"0"},"ka_in":{"group":"1","dataset":"CL","label":"Openness of Capital Inflows Index  (1=fully liberalized)","datasource":"\/external\/datamapper\/api\/index.php?values=ka_in","description":"Openness of Capital Inflows Index captures the ability to the purchase locally by non-residents and sale or issue abroad by residents across nine types of asset categories: equity, bond, money market, collective investment, derivates and other instruments, commercial credit, financial credit, direct investment, and guarantees. Range between 0 to 1 (1 indicates fully liberalized).","decimalrounding":"2","legend":[{"label":"0.8 - 1","color":"#1e75b2","min":"0.8","max":"1.5"},{"color":"#9dbdce","max":"0.8","label":"0.6 - 0.8","min":"0.6"},{"label":"0.4 - 0.6","color":"#d3bdba","max":"0.6","min":"0.4"},{"label":"0.2 - 0.4","max":"0.4","color":"#f78b7e","min":"0.2"},{"max":"0.2","label":"under 0.2","min":"0","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"source":"Wang-Jahan Index","mapinfo":"EN","unit":"Units","stackable":"0"},"ka_out":{"group":"1","dataset":"CL","description":"Openness of Capital Outflows Index captures the ability to sale or issue locally by nonresidents and purchase abroad by residents across nine types of asset categories: equity, bond, money market, collective investment, derivates and other instruments, commercial credit, financial credit, direct investment, and guarantees Range between 0 to 1 (1 indicates fully liberalized).","mapinfo":"EN","legend":[{"label":"0.8 - 1","max":"1.5","color":"#1e75b2","min":"0.8"},{"color":"#9dbdce","min":"0.6","max":"0.8","label":"0.6 - 0.8"},{"min":"0.4","color":"#d3bdba","max":"0.6","label":"0.4 - 0.6"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"min":"0","label":"under 0.2","color":"#d52a25","max":"0.2"},{"label":"no data","min":"0","max":"0","color":"#d5d7da"}],"decimalrounding":"2","label":"Openness of Capital Outflows Index   (1=fully liberalized)","unit":"Units","datasource":"\/external\/datamapper\/api\/index.php?values=ka_out","source":"Wang-Jahan Index","stackable":"0"},"FM_ka":{"dataset":"CL","group":"1","description":"Financial Market Openness Index is the unweighted average of the openness of twelve types of asset categories: equity, bond, money market, collective investment, derivates and other instruments. Range between 0 to 1 (1 indicates fully liberalized).","datasource":"\/external\/datamapper\/api\/index.php?values=FM_ka","unit":"Units","legend":[{"label":"0.8 - 1","max":"1.5","min":"0.8","color":"#1e75b2"},{"min":"0.6","color":"#9dbdce","max":"0.8","label":"0.6 - 0.8"},{"max":"0.6","label":"0.4 - 0.6","color":"#d3bdba","min":"0.4"},{"color":"#f78b7e","max":"0.4","label":"0.2 - 0.4","min":"0.2"},{"label":"under 0.2","min":"0","max":"0.2","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"source":"Wang-Jahan Index","decimalrounding":"2","mapinfo":"EN","label":"Financial Market Openness Index (equity, bond, money market, collective investment, derivates) 1=fully liberalized","stackable":"0"},"Nonres_ka":{"dataset":"CL","group":"1","label":"Nonresident Openness Index (1=fully liberalized)","decimalrounding":"2","mapinfo":"EN","legend":[{"label":"0.8 - 1","min":"0.8","color":"#1e75b2","max":"1.5"},{"min":"0.6","max":"0.8","color":"#9dbdce","label":"0.6 - 0.8"},{"label":"0.4 - 0.6","min":"0.4","max":"0.6","color":"#d3bdba"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","color":"#d52a25","min":"0","label":"under 0.2"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"unit":"Units","datasource":"\/external\/datamapper\/api\/index.php?values=Nonres_ka","description":"Nonresident Openness captures the ability of nonresidents to purchase locally (inflow) and sale or issue locally (outflow) across five asset categories: equity, bonds, money market instruments, collective investment, and derivatives and other instruments transaction.   Range between 0 to 1 (1 indicates fully liberalized).","source":"Wang-Jahan Index","stackable":"0"},"Res_ka":{"group":"1","dataset":"CL","description":"Resident Openness Index captures the ability of residents to purchase abroad (outflow) and sale or issue abroad (inflow) across five asset categories: equity, bonds, money market instruments, collective investment, and derivatives and other instruments transaction. Range between 0 to 1 (1 indicates fully liberalized).","legend":[{"max":"1.5","color":"#1e75b2","label":"0.8 - 1","min":"0.8"},{"max":"0.8","min":"0.6","label":"0.6 - 0.8","color":"#9dbdce"},{"label":"0.4 - 0.6","max":"0.6","color":"#d3bdba","min":"0.4"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","label":"under 0.2","min":"0","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"decimalrounding":"2","datasource":"\/external\/datamapper\/api\/index.php?values=Res_ka","mapinfo":"EN","source":"Wang-Jahan Index","label":"Resident Openness Index (1=fully liberalized)","stackable":"0","unit":"Units"},"Ka_eq":{"dataset":"CL","group":"2","mapinfo":"EN","legend":[{"label":"0.8 - 1","color":"#1e75b2","min":"0.8","max":"1.5"},{"label":"0.6 - 0.8","color":"#9dbdce","min":"0.6","max":"0.8"},{"color":"#d3bdba","label":"0.4 - 0.6","max":"0.6","min":"0.4"},{"color":"#f78b7e","max":"0.4","label":"0.2 - 0.4","min":"0.2"},{"label":"under 0.2","max":"0.2","color":"#d52a25","min":"0"},{"min":"0","label":"no data","max":"0","color":"#d5d7da"}],"datasource":"\/external\/datamapper\/api\/index.php?values=Ka_eq","unit":"Units","description":"Equity openness index captures the ability to conduct transactions involving shares and other securities of a participating nature, excluding those investments for the purpose of acquiring a lasting economic interest which are addressed as a foreign direct investment. It has four sub-components: Purchase locally by nonresidents (equity) | Sale or issue locally by nonresidents (equity) | Purchase abroad by residents (equity) | Sale or issue abroad by residents (equity). (1=fully liberalized)","decimalrounding":"2","label":"Equity openness index (1=fully liberalized)","source":"Wang-Jahan Index","stackable":"0"},"Ka_bo":{"dataset":"CL","group":"2","description":"Bond openness index captures the ability to conduct operations with bonds or other debt securities (notes and debentures) with an original maturity of more than one year. It has four sub-components: Purchase locally by nonresidents (bond) | Sale or issue locally by nonresidents (bond) | Purchase abroad by residents (bond) | Sale or issue abroad by residents (bond). (1=fully liberalized)","label":"Bond openness index (1=fully liberalized)","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_bo","legend":[{"color":"#1e75b2","label":"0.8 - 1","max":"1.5","min":"0.8"},{"min":"0.6","color":"#9dbdce","label":"0.6 - 0.8","max":"0.8"},{"label":"0.4 - 0.6","color":"#d3bdba","max":"0.6","min":"0.4"},{"label":"0.2 - 0.4","max":"0.4","color":"#f78b7e","min":"0.2"},{"max":"0.2","min":"0","label":"under 0.2","color":"#d52a25"},{"color":"#d5d7da","max":"0","min":"0","label":"no data"}],"decimalrounding":"2","source":"Wang-Jahan Index","mapinfo":"EN","stackable":"0","unit":"Units"},"Ka_mm":{"group":"2","dataset":"CL","legend":[{"label":"0.8 - 1","min":"0.8","color":"#1e75b2","max":"1.5"},{"color":"#9dbdce","max":"0.8","label":"0.6 - 0.8","min":"0.6"},{"label":"0.4 - 0.6","color":"#d3bdba","max":"0.6","min":"0.4"},{"color":"#f78b7e","max":"0.4","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","label":"under 0.2","min":"0","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=Ka_mm","decimalrounding":"2","description":"Money market openness index captures the ability to conduct operations with securities with an original maturity of one year or less, including short-term instruments like certificates of deposits and bills of exchange, among others. It has four sub-components: Purchase locally by nonresidents (money market) | Sale or issue locally by nonresidents (money market) | Purchase abroad by residents (money market) | Sale or issue abroad by residents (money market). (1=fully liberalized)","source":"Wang-Jahan Index","label":"Money market openness index (1=fully liberalized)","unit":"Units","mapinfo":"EN","stackable":"0"},"Ka_ci":{"dataset":"CL","group":"2","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_ci","description":"Collective investment openness index captures the ability to conduct operations through share certificates and registry entries or other evidence of investor in an institution for collective investment such as mutual funds and investment trusts. It has four sub-components: Purchase locally by nonresidents (collective investment) | Sale or issue locally by nonresidents (collective investment) | Purchase abroad by residents (collective investment) | Sale or issue abroad by residents (collective investment). (1=fully liberalized)","mapinfo":"EN","legend":[{"label":"0.8 - 1","max":"1.5","color":"#1e75b2","min":"0.8"},{"min":"0.6","color":"#9dbdce","max":"0.8","label":"0.6 - 0.8"},{"label":"0.4 - 0.6","color":"#d3bdba","max":"0.6","min":"0.4"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"min":"0","max":"0.2","color":"#d52a25","label":"under 0.2"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"decimalrounding":"2","label":"Collective investment openness index (1=fully liberalized)","unit":"Units","stackable":"0","source":"Wang-Jahan Index"},"Ka_dr":{"group":"2","dataset":"CL","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_dr","source":"Wang-Jahan Index","label":"Derivative investment openness index (1=fully liberalized)","description":"Derivative investment openness index captures the ability to conduct operations in rights, warrants, financial options and futures, secondary market operations in other financial claims (including sovereign loans, receivables, and discounted bills of trade), forward operations, swaps of bonds and other debt securities, and operations in foreign exchange without any other underlying transaction (spot or forward trading on the foreign exchange markets, forward cover operations). It has four sub-components: Purchase locally by nonresidents (derivative investment) | Sale or issue locally by nonresidents (derivative investment) | Purchase abroad by residents (derivative investment) | Sale or issue abroad by residents (derivative investment). (1=fully liberalized)","decimalrounding":"2","unit":"Units","legend":[{"label":"0.8 - 1","max":"1.5","color":"#1e75b2","min":"0.8"},{"max":"0.8","label":"0.6 - 0.8","min":"0.6","color":"#9dbdce"},{"color":"#d3bdba","label":"0.4 - 0.6","max":"0.6","min":"0.4"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","min":"0","label":"under 0.2","color":"#d52a25"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"stackable":"0","mapinfo":"EN"},"Ka_cc":{"dataset":"CL","group":"2","legend":[{"label":"0.8 - 1","max":"1.5","min":"0.8","color":"#1e75b2"},{"min":"0.6","color":"#9dbdce","max":"0.8","label":"0.6 - 0.8"},{"label":"0.4 - 0.6","min":"0.4","max":"0.6","color":"#d3bdba"},{"label":"0.2 - 0.4","color":"#f78b7e","max":"0.4","min":"0.2"},{"label":"under 0.2","max":"0.2","color":"#d52a25","min":"0"},{"color":"#d5d7da","max":"0","min":"0","label":"no data"}],"source":"Wang-Jahan Index","decimalrounding":"2","unit":"Units","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_cc","description":"Commercial credit openness index captures the ability to conduct operations directly linked with international trade transactions or with the rendering of international services. It has two sub-components: Commercial credit inflow liberalization | Commercial credit outflow liberalization. (1=fully liberalized)","label":"Commercial credit openness index (1=fully liberalized)","mapinfo":"EN","stackable":"0"},"Ka_fc":{"group":"2","dataset":"CL","decimalrounding":"2","legend":[{"max":"1.5","label":"0.8 - 1","color":"#1e75b2","min":"0.8"},{"max":"0.8","min":"0.6","label":"0.6 - 0.8","color":"#9dbdce"},{"label":"0.4 - 0.6","max":"0.6","color":"#d3bdba","min":"0.4"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","label":"under 0.2","min":"0","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=Ka_fc","mapinfo":"EN","description":"Financial credit openness index captures the ability to conduct operations through credits other than commercial credits granted by all residents, including banks to nonresidents or vice versa. It has two sub-components: Financial credit inflow liberalization | Financial credit outflow liberalization. (1=fully liberalized)","label":"Financial credit openness index (1=fully liberalized)","source":"Wang-Jahan Index","stackable":"0","unit":"Units"},"Ka_gu":{"dataset":"CL","group":"2","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_gu","mapinfo":"EN","description":"Guarantee openness index captures the ability to conduct operations through guarantees, sureties, and financial backup facilities provided by residents to nonresidents and vice versa. It also includes securities pledged for payment or performance of a contract\u2014such as warrants, performance bonds, and standby letters of credit\u2014and financial backup facilities that are credit facilities used as a guarantee for independent financial operations. It has two sub-components: Guarantee inflow liberalization | Guarantee outflow liberalization. (1=fully liberalized)","legend":[{"label":"0.8 - 1","color":"#1e75b2","min":"0.8","max":"1.5"},{"min":"0.6","label":"0.6 - 0.8","color":"#9dbdce","max":"0.8"},{"max":"0.6","label":"0.4 - 0.6","color":"#d3bdba","min":"0.4"},{"max":"0.4","color":"#f78b7e","label":"0.2 - 0.4","min":"0.2"},{"max":"0.2","color":"#d52a25","label":"under 0.2","min":"0"},{"label":"no data","max":"0","color":"#d5d7da","min":"0"}],"decimalrounding":"2","unit":"Units","label":"Guarantee openness index (1=fully liberalized)","stackable":"0","source":"Wang-Jahan Index"},"Ka_di":{"dataset":"CL","group":"2","datasource":"\/external\/datamapper\/api\/index.php?values=Ka_di","legend":[{"min":"0.8","color":"#1e75b2","label":"0.8 - 1","max":"1.5"},{"label":"0.6 - 0.8","color":"#9dbdce","min":"0.6","max":"0.8"},{"color":"#d3bdba","label":"0.4 - 0.6","min":"0.4","max":"0.6"},{"color":"#f78b7e","max":"0.4","label":"0.2 - 0.4","min":"0.2"},{"label":"under 0.2","max":"0.2","color":"#d52a25","min":"0"},{"min":"0","label":"no data","max":"0","color":"#d5d7da"}],"unit":"Units","description":"Direct investment openness index captures the ability to conduct investments for the purpose of establishing lasting economic relations both abroad by residents and domestically by non residents (for example, for the purpose of producing goods and services, and, to allow investor participation in the management of an enterprise). The index is the average of its two sub-components: direct investment inflow index and direct investment outflow index. Direct investment inflow liberalization | Direct investment outflow liberalization. (1=fully liberalized)","mapinfo":"EN","decimalrounding":"2","label":"Direct investment openness index (1=fully liberalized)","source":"Wang-Jahan Index","stackable":"0"},"ka_ldi":{"group":"2","dataset":"CL","legend":[{"label":"Full liberalized - 1","min":"0.5","color":"#1e75b2","max":"1.5"},{"color":"#d52a25","label":"Not liberalized - 0","min":"0","max":"0.5"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=ka_ldi","label":"Direct investment liquidation openness index (1=fully liberalized)","description":"Direct investment liquidation openness index captures the ability to transfer principal, including the initial capital and capital gains of a foreign direct investment. The index does not have sub- components. (1=fully liberalized).","decimalrounding":"2","source":"Wang-Jahan Index","mapinfo":"EN","unit":"Units","stackable":"0"},"ka_ret":{"group":"2","dataset":"CL","description":"Real estate capital transaction openness index captures the ability to acquire real estate not associated with direct investment, including, for example investment of a purely financial nature in real estate or the acquisition of real estate for personal use. The index does not have sub- components. (1=fully liberalized).","legend":[{"color":"#1e75b2","min":"0.5","label":"Full liberalized - 1","max":"1.5"},{"label":"Not liberalized - 0","min":"0","max":"0.5","color":"#d52a25"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"decimalrounding":"2","datasource":"\/external\/datamapper\/api\/index.php?values=ka_ret","source":"Wang-Jahan Index","label":"Real estate capital transaction openness index (1=fully liberalized)","stackable":"0","unit":"Units","mapinfo":"EN"},"ka_pct":{"group":"2","dataset":"CL","legend":[{"label":"Full liberalized - 1","max":"1.5","min":"0.5","color":"#1e75b2"},{"color":"#d52a25","label":"Not liberalized - 0","min":"0","max":"0.5"},{"color":"#d5d7da","max":"0","min":"0","label":"no data"}],"mapinfo":"EN","decimalrounding":"2","label":"Personal capital transaction openness index (1=fully liberalized)","source":"Wang-Jahan Index","datasource":"\/external\/datamapper\/api\/index.php?values=ka_pct","unit":"Units","description":"Personal capital transaction openness index captures the ability to conduct transactions initiated on behalf of private persons and intended to benefit other private persons. It includes transactions involving property to which the promise of a return to the owner with payments of interest is attached (e.g., loans or settlements of debt in their country of origin by immigrants) and transfers effected free of charge to the beneficiary (for example, gifts and endowments, loans, inheritances and legacies, and emigrants' assets). The index does not have sub- components. (1=fully liberalized).","stackable":"0"},"Reserves_ARA":{"dataset":"ARA","group":"1","chart":"both","datasource":"\/external\/datamapper\/api\/index.php?values=Reserves_ARA","description":"The ratio of reserves to the ARA metric: a ratio between 1 and 1.5 suggests that the level of reserves is adequate. Specific characteristics and circumstances, such as capital account openness, may warrant changes to the baseline ARA metric for certain countries. Any adjustments made to the baseline ARA metric are detailed in the published staff reports.","legend":[{"max":"10","min":"1.5","color":"#97AF7D","label":"1.5 and more"},{"max":"1.5","color":"#B7CCA3","label":"1 - 1.5","min":"1"},{"label":"0.5 - 1","max":"1","min":"0.5","color":"#9dbdce"},{"min":"0","color":"#b74e4f","label":"under 0.5","max":"0.5"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"source":"Assessing Reserve Adequacy - ARA","mapinfo":"EN","decimalrounding":"2","unit":"Unit","label":"Ratio of reserve\/ARA metric ","stackable":"0"},"Reserves_M2":{"group":"1","dataset":"ARA","chart":"both","decimalrounding":"2","legend":[{"color":"#97AF7D","label":"0.5 and more","max":"10","min":"0.5"},{"max":"0.5","min":"0.2","label":"0.2 - 0.5","color":"#B7CCA3"},{"min":"0.05","color":"#9dbdce","label":"0.05 - 0.2","max":"0.2"},{"max":"0.05","label":"under 0.05","color":"#b74e4f","min":"0"},{"max":"0","color":"#d5d7da","min":"0","label":"no data"}],"label":"Reserves\/Broad Money","datasource":"\/external\/datamapper\/api\/index.php?values=Reserves_M2","stackable":"0","unit":"Unit","mapinfo":"EN","description":"Reserves\/Broad money \u0096 typically M2","source":"Assessing Reserve Adequacy - ARA"},"Reserves_STD":{"group":"1","dataset":"ARA","chart":"both","decimalrounding":"2","datasource":"\/external\/datamapper\/api\/index.php?values=Reserves_STD","legend":[{"max":"150","min":"1.5","color":"#97AF7D","label":"1.5 and more"},{"label":"1 - 1.5","max":"1.5","color":"#B7CCA3","min":"1"},{"min":"0.5","color":"#9dbdce","max":"1","label":"0.5 - 1"},{"color":"#b74e4f","max":"0.5","label":"under 0.5","min":"0"},{"label":"no data","max":"0","min":"0","color":"#d5d7da"}],"label":"Reserves\/Short-term Debt (STD)","stackable":"0","description":"Reserves\/Short-term Debt (STD) \u0096 \u0093Greenspan-Guidotti\u0094 rule of 100% cover of STD is a widely-used standard of adequacy for EMs","unit":"Unit","source":"Assessing Reserve Adequacy - ARA","mapinfo":"EN"},"Reserves_M":{"dataset":"ARA","group":"1","legend":[{"label":"12 and more","min":"12","color":"#97AF7D","max":"100"},{"min":"6","label":"6 - 12","color":"#B7CCA3","max":"12"},{"label":"3 - 6","color":"#9dbdce","max":"6","min":"3"},{"color":"#b74e4f","max":"3","label":"under 3","min":"0"},{"min":"0","max":"0","color":"#d5d7da","label":"no data"}],"decimalrounding":"2","unit":"Unit","description":"Import cover \u0096 A measure of the number of months imports can be sustained should all inflows cease","datasource":"\/external\/datamapper\/api\/index.php?values=Reserves_M","mapinfo":"EN","chart":"both","stackable":"0","label":"Reserve\/(Import\/12) ","source":"Assessing Reserve Adequacy - ARA"},"GRB_dummy":{"group":"1","dataset":"GD","datasource":"\/external\/datamapper\/api\/index.php?values=GRB_dummy","legend":[{"min":"2.5","max":"40","color":"#1e75b2","label":"Prominent GB"},{"color":"#9dbdce","label":"Other GB","min":"1.5","max":"2.5"},{"color":"#D8F0F8","label":"Other countries","max":"1.5"},{"label":"No data","color":"#d5d7da"}],"unit":"Index","label":"Gender Budgeting Indicator","mapinfo":"EN","description":"GB: Gender budgeting\n3 - Prominent GB countries covered in the surveys\n2 - Other GB countries covered in the surveys\n1 - Other countries\n<b>Note<\/b>: Line charts below indicate number of countries in each GB group","source":"Stotsky (2016)"},"GDI_TC":{"dataset":"GD","group":"2","label":"Gender Development Index (GDI) Time Consistent","datasource":"\/external\/datamapper\/api\/index.php?values=GDI_TC","legend":[{"color":"#1e75b2","min":"0.96","label":"More than 0.96","max":"2"},{"label":"0.91 - 0.96","color":"#9dbdce","max":"0.96","min":"0.91"},{"color":"#f78b7e","min":"0.78","label":"0.78 - 0.91","max":"0.91"},{"color":"#d52a25","label":"Less than 0.78","max":"0.78"},{"color":"#d5d7da","label":"no data"}],"source":"Stotsky, Shibuya, Kolovich, and Kebhaj (2016)","description":"The GDI generally ranges from 0-1, with higher numbers signifying more equality\n<b>Note<\/b>: Line charts below indicate average index value in each group","mapinfo":"EN","decimalrounding":"2","unit":"Index"},"GII_TC":{"dataset":"GD","group":"2","decimalrounding":"2","unit":"Index","label":"Gender Inequality Index (GII) Time Consistent","description":"The GII generally ranges from 0-1, with higher numbers signifying more inequality\n<b>Note<\/b>: Line charts below indicate average index value in each group+B4","legend":[{"color":"#d52a25","min":"0.54","label":"More than 0.54","max":"2"},{"color":"#f78b7e","label":"0.37 - 0.54","max":"0.54","min":"0.37"},{"color":"#9dbdce","min":"0.16","max":"0.37","label":"0.16 - 0.37"},{"label":"Less than 0.16","color":"#1e75b2","max":"0.16"},{"color":"#d5d7da","label":"no data"}],"datasource":"\/external\/datamapper\/api\/index.php?values=GII_TC","mapinfo":"EN","source":"Stotsky, Shibuya, Kolovich, and Kebhaj (2016)"},"DEBT1":{"group":"1","dataset":"DEBT","datasource":"\/external\/datamapper\/api\/index.php?values=DEBT1","legend":[{"color":"#ff3300","max":"250","label":"100 or more","min":"100"},{"max":"100","color":"#ff9900","label":"65 - 100","min":"65"},{"label":"30 - 65","color":"#ffff33","max":"65","min":"30"},{"max":"30","label":"0 - 30","color":"#33cc33"},{"label":"no data","color":"#d5d7da"}],"mapinfo":"EN","minvalue":"0","description":"DEBT\r\n<br\/> Note: Median value reported for country groupings","label":"DEBT","maxvalue":"250","unit":"% of GDP","stackable":"0","source":"Fiscal Affairs Departmental Data"},"Privatedebt_all":{"dataset":"GDD","group":"1","legend":[{"label":"300% or more","max":"700","color":"#d48639","min":"300"},{"min":"250","color":"#436c7c","max":"300","label":"250% - 300%"},{"label":"200% - 250%","color":"#7eb25b","min":"200","max":"250"},{"color":"#1c9352","label":"150% - 200%","max":"200","min":"150"},{"max":"150","min":"0","label":"less than 150%","color":"#0f724d"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"description":"Total stock of debt liabilities issued by households and nonfinancial corporations, including all debt instruments, as a share of GDP.","label":"Private debt, all instruments","source":"Global Debt Database (Dec 2024)","datasource":"\/external\/datamapper\/api\/index.php?values=Privatedebt_all","mapinfo":"EN","stackable":"0","unit":"Percent of GDP"},"HH_ALL":{"group":"1","dataset":"GDD","legend":[{"max":"500","label":"100% or more","min":"100","color":"#d48639"},{"color":"#436c7c","max":"100","label":"80% - 100%","min":"80"},{"label":"60% - 80%","min":"60","color":"#7eb25b","max":"80"},{"label":"40% - 60%","min":"40","color":"#1c9352","max":"60"},{"label":"less than 40%","min":"0","color":"#0f724d","max":"40"},{"max":"0","label":"no data","color":"#d5d7da","min":"0"}],"stackable":"0","datasource":"\/external\/datamapper\/api\/index.php?values=HH_ALL","description":"Total stock of debt liabilities issued by households, including all debt instruments, as a share of GDP.","unit":"Percent of GDP","source":"Global Debt Database (Dec 2024)","mapinfo":"EN","label":"Household debt, all instruments"},"NFC_ALL":{"group":"1","dataset":"GDD","legend":[{"max":"500","min":"175","color":"#d48639","label":"175% or more"},{"color":"#436c7c","min":"150","label":"150% - 175%","max":"175"},{"color":"#7eb25b","label":"125% - 150%","min":"125","max":"150"},{"label":"100% - 125%","min":"100","color":"#1c9352","max":"125"},{"max":"100","min":"0","color":"#0f724d","label":"less than 100%"},{"min":"0","label":"no data","max":"0","color":"#d5d7da"}],"description":"Total stock of debt liabilities issued by nonfinancial corporations, including all debt instruments, as a share of GDP.","source":"Global Debt Database (Dec 2024)","datasource":"\/external\/datamapper\/api\/index.php?values=NFC_ALL","mapinfo":"EN","label":"Nonfinancial corporate debt, all instruments","unit":"Percent of GDP","stackable":"0"},"PVD_LS":{"group":"1","dataset":"GDD","description":"Total stock of loans and debt securities issued by households and nonfinancial corporations as a share of GDP.","legend":[{"max":"500","color":"#d48639","label":"100% or more","min":"100"},{"max":"100","color":"#436c7c","min":"75","label":"75% - 100%"},{"label":"50% - 75%","max":"75","min":"50","color":"#7eb25b"},{"max":"50","color":"#1c9352","min":"25","label":"25% - 50%"},{"min":"0","max":"25","label":"less than 25%","color":"#0f724d"},{"label":"no data","max":"0","min":"0","color":"#d5d7da"}],"unit":"Percent of GDP","source":"Global Debt Database (Dec 2024)","label":"Private debt, loans and debt securities","datasource":"\/external\/datamapper\/api\/index.php?values=PVD_LS","stackable":"0","mapinfo":"EN"},"HH_LS":{"dataset":"GDD","group":"1","legend":[{"max":"500","color":"#d48639","label":"100% or more","min":"100"},{"min":"75","color":"#436c7c","label":"75% - 100%","max":"100"},{"label":"50% - 75%","color":"#7eb25b","max":"75","min":"50"},{"label":"25% - 50%","min":"25","color":"#1c9352","max":"50"},{"label":"less than 25%","max":"25","min":"0","color":"#0f724d"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"description":"Total stock of loans and debt securities issued by households as a share of GDP.","stackable":"0","datasource":"\/external\/datamapper\/api\/index.php?values=HH_LS","mapinfo":"EN","label":"Household debt, loans and debt securities","source":"Global Debt Database (Dec 2024)","unit":"Percent of GDP"},"NFC_LS":{"dataset":"GDD","group":"1","legend":[{"max":"500","color":"#d48639","label":"100% or more","min":"100"},{"label":"75% - 100%","max":"100","color":"#436c7c","min":"75"},{"color":"#7eb25b","max":"75","label":"50% - 75%","min":"50"},{"color":"#1c9352","min":"25","label":"25% - 50%","max":"50"},{"min":"0","label":"less than 25%","color":"#0f724d","max":"25"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"description":"Total stock of loans and debt securities issued by nonfinancial corporations as a share of GDP.","label":"Nonfinancial corporate debt, loans and debt securities","source":"Global Debt Database (Dec 2024)","mapinfo":"EN","datasource":"\/external\/datamapper\/api\/index.php?values=NFC_LS","stackable":"0","unit":"Percent of GDP"},"PS_DEBT_GDP":{"dataset":"GDD","group":"2","mapinfo":"EN","label":"Public Sector Debt","datasource":"\/external\/datamapper\/api\/index.php?values=PS_DEBT_GDP","legend":[{"max":"500","min":"100","color":"#d48639","label":"100% or more"},{"label":"75% - 100%","min":"75","max":"100","color":"#436c7c"},{"max":"75","color":"#7eb25b","label":"50% - 75%","min":"50"},{"max":"50","label":"25% - 50%","min":"25","color":"#1c9352"},{"max":"25","color":"#0f724d","label":"less than 25%","min":"0"},{"max":"0","label":"no data","color":"#d5d7da","min":"0"}],"description":"Total stock of debt liabilities issued by the public sector as a share of GDP.","unit":"Percent of GDP","source":"Global Debt Database (Dec 2024)","stackable":"0"},"NFPS_DEBT_GDP":{"group":"2","dataset":"GDD","legend":[{"max":"500","min":"100","color":"#d48639","label":"100% or more"},{"max":"100","label":"75% - 100%","min":"75","color":"#436c7c"},{"color":"#7eb25b","label":"50% - 75%","min":"50","max":"75"},{"min":"25","label":"25% - 50%","max":"50","color":"#1c9352"},{"max":"25","color":"#0f724d","label":"less than 25%","min":"0"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"source":"Global Debt Database (Dec 2024)","description":"Total stock of debt liabilities issued by the nonfinancial public sector as a share of GDP. ","label":"Nonfinancial Public Sector Debt","datasource":"\/external\/datamapper\/api\/index.php?values=NFPS_DEBT_GDP","mapinfo":"EN","stackable":"0","unit":"Percent of GDP"},"GG_DEBT_GDP":{"group":"2","dataset":"GDD","source":"Global Debt Database (Dec 2024)","legend":[{"max":"500","color":"#d48639","label":"100% or more","min":"100"},{"label":"75% - 100%","color":"#436c7c","max":"100","min":"75"},{"color":"#7eb25b","label":"50% - 75%","max":"75","min":"50"},{"color":"#1c9352","max":"50","label":"25% - 50%","min":"25"},{"label":"less than 25%","min":"0","max":"25","color":"#0f724d"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"stackable":"0","datasource":"\/external\/datamapper\/api\/index.php?values=GG_DEBT_GDP","label":"General Government Debt","description":"Total stock of debt liabilities issued by the general government as a share of GDP. ","unit":"Percent of GDP","mapinfo":"EN"},"CG_DEBT_GDP":{"group":"2","dataset":"GDD","label":"Central Government Debt","stackable":"0","legend":[{"max":"500","min":"100","color":"#d48639","label":"100% or more"},{"color":"#436c7c","min":"75","max":"100","label":"75% - 100%"},{"max":"75","color":"#7eb25b","label":"50% - 75%","min":"50"},{"label":"25% - 50%","color":"#1c9352","max":"50","min":"25"},{"max":"25","color":"#0f724d","min":"0","label":"less than 25%"},{"min":"0","color":"#d5d7da","max":"0","label":"no data"}],"datasource":"\/external\/datamapper\/api\/index.php?values=CG_DEBT_GDP","mapinfo":"EN","description":"Total stock of debt liabilities issued by the central government as a share of GDP.","source":"Global Debt Database (Dec 2024)","unit":"Percent of GDP"},"GGXCNL_G01_GDP_PT":{"dataset":"FM","group":"1","legend":[{"max":"200","min":"2","color":"#B7CCA3","label":"2% or more"},{"max":"2","min":"0","color":"#ffff33","label":"0 - 2%"},{"max":"0","label":"-2% - 0","color":"#ff9933","min":"-2"},{"label":"-4% - -2%","min":"-4","color":"#ff0000","max":"-2"},{"min":"-600","color":"#bd1010","max":"-4","label":"Less than -4%"},{"label":"not in FM sample","max":"0","color":"#d5d7da","min":"0"}],"mapinfo":"EN","unit":"% of GDP","datasource":"\/external\/datamapper\/api\/index.php?values=GGXCNL_G01_GDP_PT","label":"Net lending\/borrowing (also referred as overall balance)","stackable":"0","description":"Defined as the difference between revenue and total expenditure, using the 2014 edition of the IMF\u0092s Government Finance Statistics Manual (GFSM 2014). Does not include policy lending. For some countries, the overall balance continues to be based on GFSM 1986, which is defined as total revenue and grants minus total expenditure and net lending.","source":"Fiscal Monitor (April 2025)"},"GGXONLB_G01_GDP_PT":{"group":"1","dataset":"FM","legend":[{"max":"200","label":"2% or more","min":"2","color":"#B7CCA3"},{"label":"0 - 2%","color":"#ffff33","max":"2","min":"0"},{"color":"#ff9933","min":"-2","label":"-2% - 0","max":"0"},{"label":"-4% - -2%","color":"#ff0000","min":"-4","max":"-2"},{"min":"-600","color":"#bd1010","max":"-4","label":"Less than -4%"},{"color":"#d5d7da","label":"not in FM sample","max":"0","min":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=GGXONLB_G01_GDP_PT","description":"Overall balance excluding net interest payment (interest expenditure minus interest revenue).","mapinfo":"EN","unit":"% of GDP","stackable":"0","label":"Primary net lending\/borrowing (also referred as primary balance)","source":"Fiscal Monitor (April 2025)"},"GGCB_G01_PGDP_PT":{"dataset":"FM","group":"1","datasource":"\/external\/datamapper\/api\/index.php?values=GGCB_G01_PGDP_PT","label":"Cyclically adjusted balance","legend":[{"max":"200","color":"#B7CCA3","min":"2","label":"2% or more"},{"max":"2","color":"#ffff33","min":"0","label":"0 - 2%"},{"color":"#ff9933","label":"-2% - 0","max":"0","min":"-2"},{"min":"-4","color":"#ff0000","label":"-4% - -2%","max":"-2"},{"max":"-4","color":"#bd1010","min":"-40","label":"Less than -4%"},{"min":"0","color":"#d5d7da","label":"not in FM sample","max":"0"}],"description":"Difference between the overall balance and the automatic stabilizers; equivalently, an estimate of the fiscal balance that would apply under current policies if ou