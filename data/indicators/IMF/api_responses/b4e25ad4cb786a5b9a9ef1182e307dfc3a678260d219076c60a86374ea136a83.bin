T"],"ADVEC":["AUS","AUT","BEL","CAN","CHE","CYP","CZE","DEU","DNK","ESP","EST","FIN","FRA","GBR","GRC","HKG","HRV","IRL","ISL","ISR","ITA","JPN","KOR","LTU","LUX","LVA","MAC","MLT","NLD","NOR","NZL","PRI","PRT","SGP","SMR","SVK","SVN","SWE","TWN","USA","AND"],"FAD_EuroArea":["AUS","BEL","CYP","DEU","ESP","EST","FIN","FRA","GRC","HRV","IRL","ITA","NLD","PRT","SVK","SVN"],"FM_EMEEU":["AZE","HUN","KAZ","POL","ROU","RUS","TUR","UKR"],"FM_LICSSA":["BDI","CAF","COM","ERI","GMB","GNB","LBR","LSO","MWI","SLE","SSD","STP","TGO"],"FM_LIDCSSA":["BEN","BFA","CIV","CMR","COD","COG","ETH","GHA","GIN","KEN","MDG","MLI","MOZ","NER","NGA","RWA","SEN","TCD","TZA","UGA","ZMB","ZWE"],"FM_LIDCAsia":["BGD","KHM","LAO","MMR","MNG","NPL","PNG","VNM"],"FM_LIDCLA":["BOL","HND","HTI","NIC"],"FM_EMEAsia":["BRN","CHN","FJI","FSM","IDN","IND","LKA","MDV","MHL","MNG","MYS","NRU","PHL","PLW","THA","TON","TUV","VUT","WSM"],"FM_LICAsia":["BTN","KIR","SLB"],"MAE":["CAN","DEU","FRA","GBR","ITA","JPN","USA"],"FAD_OP":["DZA","ECU"],"":["EGY"]},"hierarchies":{"indicators":{"1":{"label":"Fiscal Indicators","indicators":["GGXCNL_G01_GDP_PT","GGXONLB_G01_GDP_PT","GGCB_G01_PGDP_PT","GGCBP_G01_PGDP_PT","GGR_G01_GDP_PT","G_X_G01_GDP_PT","G_XWDG_G01_GDP_PT","GGXWDN_G01_GDP_PT"]}},"groups":{"1":"ADVEC","2":"MAE","3":"FAD_EuroArea","4":{"code":"FM_EMG","groups":{"1":"FM_EMEAsia","2":"FM_EMEEU","3":"FM_EMELA"}},"5":{"code":"FM_LIDC","groups":{"1":"FM_LICAsia","2":"FM_LICLA","3":"FM_LICSSA","4":"FM_LICO"}}}}},"AFRREO":{"order":"3","code":"AFRREO","caption1":"AFR Economic Outlook","version":"AFR Regional Economic Outlook - April 2025","caption3":"Methodology","description":"The Africa Regional Economic Outlook (AFRREO) April 2025 database contains selected macroeconomic data series from the statistical appendix of the Regional Economic Outlook: Sub-Saharan Africa. \n\nEstimates and projections used in this report are based on data provided by IMF country desks as of April 15, 2025. Projections are IMF staff estimates. \n\nThe database covers the 45 countries of  the IMF's African Department. The data are consistent with those underlying the April 2025 World Economic Outlook (WEO). While data follows established international statistical methodologies to the extent possible, variable choice may be determined by country-specific definitions. The coverage and definitions of data for different countries are therefore not always comparable. Moreover, many countries are not yet able to compile high-quality data.\n\nCurrently, the IMF Data Mapper\u00ae includes 26 data series reported on Regional Economic Outlook - Sub-Saharan Africa.","bubbleresize_ind":"NGDP_R_PCH,GGXWDG_GDP,GGX_GDP","caption2":"AFRREO Database","projectionyear":"2025","indicator":"NGDP_R_PCH","initchart":"SSA,OEXP,OIMP","maparea":"SSA","caption4":"Feedback","indicatorx":"NGDP_R_PCH","intro1":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/REO\/SSA\/Issues\/2025\/04\/25\/regional-economic-outlook-for-sub-saharan-africa-april-2025\" target=\"new\">REO Homepage<\/a>\n<a href=\"https:\/\/www.imf.org\/-\/media\/Files\/Publications\/REO\/AFR\/2025\/April\/English\/text.ashx\" target=\"new\">Current Report<\/a>\n<a href=\"https:\/\/www.bookstore.imf.org\/books\/regional-economic-outlook-october-2022-sub-saharan-africa-living-on-the-edge\">Order print subscription<\/a>\n<a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/reo\/reorepts.aspx?ddlYear=-1&ddlRegions=11\" target=\"new\">Earlier Reports<\/a>","indicatory":"NGDPRPC_PCH","maxyear":"2026","intro2":"<a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/reo\/reorepts.aspx?ddlYear=-1&ddlRegions=11\" target=\"new\">Entire AFRREO Dataset<\/a>","intro3":"<a href=\"http:\/\/www.imf.org\/external\/datamapper\/afrreoreg.htm\" target=\"new\">Typology of Countries and Analytical Groups<\/a>","intro4":"Send comments about the IMF Data Mapper\u00ae to <a href=\"mailto:afrreo@imf.org\">afrreo@imf.org<\/a>.","title":"AFR Regional Economic Outlook","minyear":"2000","numcountries":45,"geoitems":["AGO","BDI","BEN","BFA","BWA","CAF","CIV","CMR","COD","COG","COM","CPV","ERI","ETH","GAB","GHA","GIN","GMB","GNB","GNQ","KEN","LBR","LSO","MDG","MLI","MOZ","MUS","MWI","NAM","NER","NGA","RWA","SEN","SLE","SSD","STP","SWZ","SYC","TCD","TGO","TZA","UGA","ZAF","ZMB","ZWE"],"regions":{"SSA":["AGO","BDI","BEN","BFA","BWA","CAF","CIV","CMR","COD","COG","COM","CPV","ERI","ETH","GAB","GHA","GIN","GMB","GNB","GNQ","KEN","LBR","LSO","MDG","MLI","MOZ","MUS","MWI","NAM","NER","NGA","RWA","SEN","SLE","SSD","STP","SWZ","SYC","TCD","TGO","TZA","UGA","ZAF","ZMB","ZWE"],"COMESA":["AGO","BDI","COD","COM","ETH","KEN","MDG","MUS","MWI","NAM","RWA","SWZ","SYC","UGA","ZMB","ZWE"],"SADC":["AGO","BWA","COD","COM","LSO","MDG","MOZ","MUS","MWI","NAM","SWZ","SYC","TZA","ZAF","ZMB","ZWE"],"OEXP":["AGO","CMR","COG","GAB","GNQ","NGA","SSD","TCD"],"RESINT":["AGO","BFA","BWA","CAF","CMR","COD","COG","ERI","GAB","GHA","GIN","GNQ","LBR","MLI","NAM","NER","NGA","SLE","SSD","TCD","TZA","ZAF","ZMB","ZWE"],"SSENS":["AGO","BDI","BEN","BFA","BWA","CAF","CIV","CMR","COD","COG","COM","CPV","ERI","ETH","GAB","GHA","GIN","GMB","GNB","GNQ","KEN","LBR","LSO","MDG","MLI","MOZ","MUS","MWI","NAM","NER","RWA","SEN","SLE","SSD","STP","SWZ","SYC","TCD","TGO","TZA","UGA","ZMB","ZWE"],"OXEN853":["AGO","CMR","COG","GAB","GNQ","SSD","TCD"],"MIC":["AGO","BEN","BWA","CIV","CMR","COG","COM","CPV","GAB","GHA","GNQ","KEN","LSO","MUS","NAM","NGA","SEN","STP","SWZ","SYC","ZAF","ZMB"],"MIC854":["AGO","BEN","BWA","CIV","CMR","COG","CPV","GAB","GHA","GNQ","KEN","LSO","MUS","NAM","SEN","STP","SWZ","SYC","ZMB"],"LIC":["BDI","BFA","CAF","COD","ERI","ETH","GIN","GMB","GNB","LBR","MDG","MLI","MOZ","MWI","NER","RWA","SLE","SSD","STP","TCD","TGO","TZA","UGA","ZWE"],"OIMP":["BDI","BEN","BFA","BWA","CAF","CIV","COD","COM","CPV","ERI","ETH","GHA","GIN","GMB","GNB","KEN","LBR","LSO","MDG","MLI","MOZ","MUS","MWI","NAM","NER","RWA","SEN","SLE","STP","SWZ","SYC","TGO","TZA","UGA","ZAF","ZMB","ZWE"],"NONRESINT":["BDI","BEN","CIV","COM","CPV","ETH","GMB","GNB","KEN","LSO","MDG","MOZ","MUS","MWI","RWA","SEN","STP","SWZ","SYC","TGO","UGA"],"OIM808":["BDI","BEN","BFA","BWA","CAF","CIV","COD","COM","CPV","ERI","ETH","GHA","GIN","GMB","GNB","KEN","LBR","LSO","MDG","MLI","MOZ","MUS","MWI","NAM","NER","RWA","SEN","SLE","STP","SWZ","SYC","TGO","TZA","UGA","ZMB","ZWE"],"FRC":["BDI","BFA","CAF","COD","COG","COM","ERI","ETH","GNB","MLI","MOZ","NER","NGA","SSD","STP","TCD","ZWE"],"EAC-5":["BDI","KEN","RWA","TZA","UGA"],"WAEMU":["BEN","BFA","CIV","GNB","MLI","NER","SEN","TGO"],"CFAFZ":["BEN","BFA","CAF","CIV","CMR","COG","GAB","GNB","GNQ","MLI","NER","SEN","TCD","TGO"],"ECOWAS":["BEN","BFA","CIV","CPV","GHA","GIN","GMB","GNB","LBR","MLI","NER","NGA","SEN","SLE","TGO"],"NO824":["BFA","BWA","CAF","COD","GHA","GIN","LBR","MLI","NAM","NER","SLE","TZA","ZAF","ZMB","ZWE"],"SACU":["BWA","LSO","NAM","SWZ","ZAF"],"CEMAC":["CAF","CMR","COG","GAB","GNQ","TCD"]," FRC":["CMR"],"NONC872":["ERI"],"LICXF":["GIN","GMB","LBR","MDG","MWI","RWA","SLE","TZA","UGA"],"LICFX":["TGO"]},"hierarchies":{"indicators":{"1":{"label":"Real Sector","indicators":["NGDP_R_PCH","NGDPXO_RPCH","NGDPRPC_PCH"]},"2":{"label":"National Accounts","indicators":["NI_GDP","NGS_GDP"]},"3":{"label":"Government and Public Sector","indicators":["GGXCNL_GDP","GGXCNLXG_GDP","GGRXG_GDP","GGX_GDP","GGXWDG_GDP"]},"4":{"label":"Financial Sector","indicators":["FMB_GDP","FDSAOP_PCH","FDSAOP_GDP","FMB_PCH"]},"5":{"label":"External Sector","indicators":["BX_GDP","BCA_GDP","BM_GDP","BT_GDP","BFD_GDP","BRASS_MI"]},"6":{"label":"Exchange Rates","indicators":["EREER","ENEER"]},"7":{"label":"External Debt and Debt Service","indicators":["DG_GDP"]},"8":{"label":"Prices","indicators":["PCPI_PCH","PCPIE_PCH","TTT"]}},"groups":{"1":{"code":"SSA","groups":{"2":"SSENS"}},"2":{"code":"OEXP","groups":{"1":"OXEN853"}},"3":{"code":"MIC","groups":{"1":"MIC854"}},"4":{"code":"LIC","groups":{"1":"LICXF","2":"FRC"}},"5":{"code":"OIMP","groups":{"1":"OIM808"}},"6":{"code":"CFAFZ","groups":{"1":"WAEMU","2":"CEMAC"}},"7":{"code":"RESINT","groups":{"1":"NO824"}},"8":"NONRESINT","9":{"code":"OTH","groups":{"1":"EAC-5","2":"ECOWAS","3":"SADC","4":"SACU","5":"COMESA"}}},"regions":{"10":"AFRREO"}}},"ARA":{"code":"ARA","order":"4","caption4":"Feedback","description":"<b>Assessing Reserve Adequacy (ARA)<\/b> dataset presents a new measure for assessing adequacy of reserve holdings for 78 emerging market countries from 2000 to present.<sup>1<\/sup> \n\n<b>Motivation<\/b>: For almost all economies, whether developed, emerging, or developing, holding prudent reserves, in conjunction with sound policies and fundamentals, can bring significant benefits. They reduce the likelihood of balance-of-payments crises, help preserve economic and financial stability against pressures on exchange rates and disorderly market conditions, and create space for policy autonomy. While reserves have these important benefits, they also carry an opportunity cost-from reserves earning a lower rate of return than could be achieved if the resources were used differently. These costs are an important consideration as countries decide on their \"appropriate\" level of reserves for precautionary purposes. \n\n<b>Assessment<\/b>: Assessing the appropriate level of reserves to hold is challenging-not just because of the multiple roles played by reserves, but also because of the complexity of quantifying external risks and vulnerabilities, and the opportunity cost each country faces. As such, the assessment should be based on the specific characteristics (including economic flexibility and financial integration and maturity) and vulnerabilities. A number of traditional approaches-including import and short-term debt coverage-have been used and remain relevant for particular sets of countries, typically capturing individual risks. \n\n<b>IMF policy papers<\/b>: A series of IMF policy papers (2011, 2013, and 2015 and listed below) have proposed new analytical frameworks to assess reserve adequacy, supplementing traditional guidance. They outline the motivations for holding reserves in developed, emerging, and developing and credit constrained economies. In addition, the papers develop new tools for emerging and developing and credit constrained economies to assess adequacy, and suggest approaches for characterizing the reserve needs for developed economies. These tools generally take a broader view of potential risks, sources of shocks, and vulnerabilities underlying reserve needs than transitional metrics. Measures of the opportunity cost of reserve holdings were also presented throughout these papers. Finally, in the 2015 paper, the importance of non-precautionary motivations for some countries was noted, and the issue of reserve adequacy assessments was placed squarely in the context of Fund surveillance. The bottom line of this work, and its application by the Fund, is summarized in the <u><a href=\"http:\/\/www.imf.org\/external\/np\/pp\/eng\/2016\/060316.pdf\" target=\"new\">2016 Guidance Note to Staff on Assessing Reserve Adequacy and Related Issues<\/a><\/u>     \n\n<small>1.\tThis metric should be included in conjunction with other relevant analyses in the Article IV consultation or other applicable staff reports for the respective economies. Specific characteristics and circumstances may warrant changes to the baseline ARA EM metric for some countries. Any adjustments made to the baseline ARA EM metric are detailed in the published staff reports for those countries.<\/small>\n","bubbleresize_ind":"LP,NGDPD","intro4":"Send comments and questions to the <u><a href=\"mailto:sprxp-ara@imf.org\" target=\"new\">ARA Data<\/a><\/u>.\n","indicator":"Reserves_ARA","caption3":"Research Papers","caption1":"Assessing Reserve Adequacy","initchart":"CHN,IND,BRA,RUS,ZAF","maparea":"ARAWORLD","indicatorx":"NGDPD","caption2":"Dataset","maxyear":"2025","title":"Assessing Reserve Adequacy - ARA (April 2025)","indicatory":"LP","intro3":"<a href=\"http:\/\/www.imf.org\/external\/np\/pp\/eng\/2014\/121914.pdf\" target=\"new\">ARA 2015<\/a>\n<a href=\"http:\/\/www.imf.org\/external\/np\/pp\/eng\/2013\/111313d.pdf\" target=\"new\">ARA 2013<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/np\/pp\/eng\/2013\/111313e.pdf\" target=\"new\">Supplement ARA 2013<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/np\/pp\/eng\/2011\/021411b.pdf\" target=\"new\">ARA 2011<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/np\/pp\/eng\/2011\/021411c.pdf\" target=\"new\">Supplement ARA 2011<\/a>","version":"Assessing Reserve Adequacy - April 2025","projectionyear":"2021","intro1":"<a href=\"http:\/\/www.imf.org\/external\/np\/pp\/eng\/2014\/121914.pdf\" target=\"new\">Assessing Reserve Adequacy - Specific Proposals (2015)<\/a>","intro2":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/aradata.xlsx\" target=\"new\">Full data<\/a>","minyear":"2000","sdmx_freq ":"FREQ","sdmx_geoitem ":"REF_AREA","numcountries":77,"geoitems":["ALB","DZA","AGO","ATG","ARG","ARM","AZE","BLR","BLZ","BOL","BIH","BRA","BGR","CHL","CHN","COL","CRI","HRV","CZE","DOM","ECU","EGY","SLV","GAB","GEO","GTM","HND","HUN","ISL","IND","IDN","IRQ","ISR","JAM","JOR","KAZ","LVA","LBN","LBY","LTU","MKD","MYS","MDV","MUS","MEX","MDA","MNG","MNE","MAR","PAK","PAN","PRY","PER","PHL","POL","ROU","RUS","SRB","SYC","SVK","SVN","ZAF","LKA","KNA","SYR","THA","TUN","TUR","TKM","UKR","ARE","URY","VEN","VNM","BHS","TTO","HSR"],"regions":{"ARAWORLD":["ALB","DZA","AGO","ATG","ARG","ARM","AZE","BLR","BLZ","BOL","BIH","BRA","BGR","CHL","CHN","COL","CRI","HRV","CZE","DOM","ECU","EGY","SLV","GAB","GEO","GTM","HND","HUN","ISL","IND","IDN","IRQ","ISR","JAM","JOR","KAZ","LVA","LBN","LBY","LTU","MKD","MYS","MDV","MUS","MEX","MDA","MNG","MNE","MAR","PAK","PAN","PRY","PER","PHL","POL","ROU","RUS","SRB","SYC","SVK","SVN","ZAF","LKA","KNA","SYR","THA","TUN","TUR","TKM","UKR","ARE","URY","VEN","VNM","BHS","TTO","HSR"]},"hierarchies":{"indicators":{"1":{"label":"Assessing Reserve Adequacy (ARA)","indicators":["Reserves_ARA","Reserves_M2","Reserves_STD","Reserves_M"]}},"groups":{"1":"ARAWORLD"}}},"GDD":{"order":"5","code":"GDD","description":"The Global Debt Database (GDD) is the result of a multiyear investigative process that started with the October 2016 Fiscal Monitor. The dataset comprises total gross debt of the (private and public) nonfinancial sector for an unbalanced panel of 190 advanced economies, emerging market economies and low-income countries, dating back to 1950. For more details on the methodology and definitions, please see the Mbaye, Moreno Badia and Chae (2018).\n\nWe rely on the feedback from users to address any problems they may encounter with the data. Notification of any omissions or supplementary sources is welcome and would be fully acknowledged. Suggestions can be sent to IMF-GDD@imf.org\n\n\nReference: Mbaye, S., Moreno-Badia, M., and K. Chae. 2018. \"<a href=\"https:\/\/www.imf.org\/en\/Publications\/WP\/Issues\/2018\/05\/14\/Global-Debt-Database-Methodology-and-Sources-45838\">Global Debt Database: Methodology and Sources<\/a>,\" IMF Working Paper, International Monetary Fund, Washington, DC\n","sdmx_geoitem ":"REF_AREA","caption4":"Feedback","caption2":"Dataset","caption3":"Methodology","caption1":"Global Debt Monitor","initchart":"SWE","bubbleresize_ind":"GG_DEBT_GDP","intro4":"Send comments and questions about<div>GDD data to: <a href=\"mailto:IMF-GDD@imf.org\"><u>IMF-GDD@imf.org<\/u><\/a><\/div> <br>\nSend us your comments about <div><a href=\"mailto:DataMapper@imf.org\"><u>DataMapper Tool<\/u><\/a><\/div> <br>\n","group2":"Public Debt","indicatorx":"GG_DEBT_GDP","group1":"Private Debt","indicator":"GG_DEBT_GDP","intro1":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/GDD\/2024 Global Debt Monitor.pdf\" target=\"new\">2024 Global Debt Monitor<\/a>","maxyear":"2023","intro2":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/GDD\/GlobalDebtDatabase.xlsx\">Full data in Excel<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/datamapper\/GDD\/GlobalDebtDatabase.zip\">Full data in Stata<\/a>","version":"Global Debt Database - Dec 2024","projectionyear":"2023","title":"Global Debt Database","indicatory":"GG_DEBT_GDP","sdmx_freq ":"FREQ","intro3":"<a href=\"http:\/\/www.imf.org\/en\/Publications\/WP\/Issues\/2018\/05\/14\/Global-Debt-Database-Methodology-and-Sources-45838\" target=\"new\">Methodology and Sources<\/a>\n","maparea":"FADGDWORLD","minyear":"1950","numcountries":190,"geoitems":["AFG","AGO","ALB","ARE","ARG","ARM","ATG","AUS","AUT","AZE","BDI","BEL","BEN","BFA","BGD","BGR","BHR","BHS","BIH","BLR","BLZ","BOL","BRA","BRB","BRN","BTN","BWA","CAF","CAN","CHE","CHL","CHN","CIV","CMR","COD","COG","COL","COM","CPV","CRI","CYP","CZE","DEU","DJI","DMA","DNK","DOM","DZA","ECU","EGY","ERI","ESP","EST","ETH","FIN","FJI","FRA","FSM","GAB","GBR","GEO","GHA","GIN","GMB","GNB","GNQ","GRC","GRD","GTM","GUY","HKG","HND","HRV","HTI","HUN","IDN","IND","IRL","IRN","IRQ","ISL","ISR","ITA","JAM","JOR","JPN","KAZ","KEN","KGZ","KHM","KIR","KNA","KOR","KWT","LAO","LBN","LBR","LBY","LCA","LKA","LSO","LTU","LUX","LVA","MAR","MDA","MDG","MDV","MEX","MHL","MKD","MLI","MLT","MMR","MNE","MNG","MOZ","MRT","MUS","MWI","MYS","NAM","NER","NGA","NIC","NLD","NOR","NPL","NRU","NZL","OMN","PAK","PAN","PER","PHL","PNG","POL","PRT","PRY","QAT","ROU","RUS","RWA","SAU","SDN","SEN","SGP","SLB","SLE","SLV","SMR","SRB","SSD","STP","SUR","SVK","SVN","SWE","SWZ","SYC","SYR","TCD","TGO","THA","TJK","TKM","TLS","TON","TTO","TUN","TUR","TUV","TWN","TZA","UGA","UKR","URY","USA",null,"UZB","VCT","VEN","VNM","VUT","WBG","WSM","YEM","ZAF","ZMB","ZWE"],"regions":{"FADGDWORLD":["AFG","AGO","ALB","ARE","ARG","ARM","ATG","AUS","AUT","AZE","BDI","BEL","BEN","BFA","BGD","BGR","BHR","BHS","BIH","BLR","BLZ","BOL","BRA","BRB","BRN","BTN","BWA","CAF","CAN","CHE","CHL","CHN","CIV","CMR","COD","COG","COL","COM","CPV","CRI","CYP","CZE","DEU","DJI","DMA","DNK","DOM","DZA","ECU","EGY","ERI","ESP","EST","ETH","FIN","FJI","FRA","FSM","GAB","GBR","GEO","GHA","GIN","GMB","GNB","GNQ","GRC","GRD","GTM","GUY","HKG","HND","HRV","HTI","HUN","IDN","IND","IRL","IRN","IRQ","ISL","ISR","ITA","JAM","JOR","JPN","KAZ","KEN","KGZ","KHM","KIR","KNA","KOR","KWT","LAO","LBN","LBR","LBY","LCA","LKA","LSO","LTU","LUX","LVA","MAR","MDA","MDG","MDV","MEX","MHL","MKD","MLI","MLT","MMR","MNE","MNG","MOZ","MRT","MUS","MWI","MYS","NAM","NER","NGA","NIC","NLD","NOR","NPL","NRU","NZL","OMN","PAK","PAN","PER","PHL","PNG","POL","PRT","PRY","QAT","ROU","RUS","RWA","SAU","SDN","SEN","SGP","SLB","SLE","SLV","SMR","SRB","SSD","STP","SUR","SVK","SVN","SWE","SWZ","SYC","SYR","TCD","TGO","THA","TJK","TKM","TLS","TON","TTO","TUN","TUR","TUV","TWN","TZA","UGA","UKR","URY","USA","UVK","UZB","VCT","VEN","VNM","VUT","WBG","WSM","YEM","ZAF","ZMB","ZWE"]},"hierarchies":{"indicators":{"1":{"label":"Private debt","indicators":["PVD_LS","HH_LS","NFC_LS","Privatedebt_all","HH_ALL","NFC_ALL"]},"2":{"label":"Public debt","indicators":["CG_DEBT_GDP","GG_DEBT_GDP","NFPS_DEBT_GDP","PS_DEBT_GDP"]}},"groups":{"1":"FADGDWORLD"}}},"AIPI":{"order":"6","code":"AIPI","caption4":"Feedback","intro1":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/AIPINote.pdf\" target=\"new\">AIPI Note<\/a>","caption1":"AI Preparedness Index (AIPI)","caption2":"Dataset","maparea":"WEOWORLD","initchart":"ADVEC,EME,LIC","title":"AI Preparedness Index (AIPI)","caption3":"Research Papers","sdmx_freq ":"FREQ","intro3":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/Staff-Discussion-Notes\/Issues\/2024\/01\/14\/Gen-AI-Artificial-Intelligence-and-the-Future-of-Work-542379\" target=\"new\">Gen-AI: Artificial Intelligence and the Future of Work<\/a>","indicator":"AI_PI","description":"<b>AI Preparedness Index (AIPI)<\/b> assesses the level of AI preparedness across 174 countries, based on a rich set of macro-structural indicators that cover the countries\u2019 digital infrastructure, human capital and labor market policies, innovation and economic integration, and regulation and ethics.\n\nSource data include official data, surveys of hard data and surveys of perceptions compiled by 8 institutions: Fraser Institute, International Labor Organization, International Telecommunication Union, United Nations, United Nations Conference on Trade and Development, Universal Postal Union, World Bank, and World Economic Forum.\n\nAs described in the index <u><a href=\"https:\/\/www.imf.org\/external\/datamapper\/AIPINote.pdf\" target=\"new\">documentation<\/a><\/u> and the <u><a href=\"https:\/\/www.imf.org\/en\/Publications\/Staff-Discussion-Notes\/Issues\/2024\/01\/14\/Gen-AI-Artificial-Intelligence-and-the-Future-of-Work-542379\" target=\"new\">published paper<\/a><\/u>, the AIPI is the sum of four key dimensions: digital infrastructure, human capital, technological innovation, and legal frameworks. These four dimensions are likely relevant for smooth AI adoption. In turn, each dimension is computed by normalizing and averaging a rich set of sub-indicators including, but not limited to, the presence of relevant digital infrastructure, sustained human capital investment, inclusive STEM expertise, labor and capital mobility, a vibrant R&D ecosystem, and the adaptability of legal frameworks to digital business models.\n\nHow to use the AIPI: \n\n1. Be aware that the index incorporates several perceptions-based indicators, reflecting individuals' subjective assessments and experiences. Therefore, the index should be seen as an indicative measure, guiding policymakers in identifying areas for improvement rather than being used for ranking purposes.\n\n2. Note that the focus is on AI adoption preparedness (rather than on invention leadership), which allows for comparability of the level of preparedness across all economies.\n\n3. Recognize that measuring AI preparedness is challenging because the institutional requirements for economy-wide integration of AI are still uncertain.","intro2":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/aipidata.xlsx\" target=\"new\">Full dataset<\/a>","maxyear":"2023","intro4":"Send us your comments and questions about the <u><a href=\"mailto:AIPIinquiries@imf.org\" target=\"new\">AIPI Data<\/a><\/u> <br><br>\nSend us your comments about <div><a href=\"mailto:DataMapper@imf.org\"><u>DataMapper Tool<\/u><\/a><\/div> <br>","projectionyear":"2023","minyear":"2023","sdmx_geoitem ":"REF_AREA","version":"AI Preparedness Index - April 2024","hierarchies":{"indicators":{"1":{"indicators":["AI_PI","DI","IEI","HCLMP","RE"],"label":"AI Preparedness Index (AIPI)"}},"groups":{"1":"WEOWORLD","2":"ADVEC","3":"EME","4":"LIC","8":"WE","9":"MECA","11":"EURO","12":"MAE","13":"EU","14":"AS5"},"regions":{"5":"APQ","6":"EUQ","7":"NMQ","10":"SSQ"}},"numcountries":173,"geoitems":["AUS","AUT","BEL","CAN","HRV","CYP","CZE","DNK","EST","FIN","FRA","DEU","GRC","HKG","ISL","IRL","ISR","ITA","JPN","KOR","LVA","LTU","LUX","MAC","MLT","NLD","NZL","NOR","PRT","PRI","SGP","SVK","SVN","ESP","SWE","CHE","TWN","GBR","USA","ALB","DZA","AGO","ARG","ARM","AZE","BHS","BHR","BRB","BLR","BLZ","BOL","BIH","BWA","BRA","BRN","BGR","CPV","CHL","CHN","COL","CRI","DOM","ECU","EGY","SLV","SWZ","FJI","GAB","GEO","GTM","GUY","HUN","IND","IDN","IRN","IRQ","JAM","JOR","KAZ","KWT","LBN","LBY","MYS","MDV","MUS","MEX","MNG","MNE","MAR","NAM","OMN","PAK","PAN","PRY","PER","PHL","POL","QAT","MKD","ROU","RUS","LCA","VCT","SAU","SRB","SYC","ZAF","LKA","SUR","SYR","THA","TTO","TUN","TUR","UKR","ARE","URY","VEN","AFG","BGD","BEN","BTN","BFA","BDI","KHM","CMR","CAF","TCD","COM","COG","COD","CIV","DJI","ETH","GMB","GHA","GIN","GNB","HTI","HND","KEN","KGZ","LAO","LSO","LBR","MDG","MWI","MLI","MRT","MDA","MOZ","MMR","NPL","NIC","NER","NGA","PNG","RWA","STP","SEN","SLE","SOM","SSD","SDN","TJK","TZA","TLS","TGO","UGA","UZB","VNM","ZMB","ZWE"],"regions":{"WEOWORLD":["AUS","AUT","BEL","CAN","HRV","CYP","CZE","DNK","EST","FIN","FRA","DEU","GRC","HKG","ISL","IRL","ISR","ITA","JPN","KOR","LVA","LTU","LUX","MAC","MLT","NLD","NZL","NOR","PRT","PRI","SGP","SVK","SVN","ESP","SWE","CHE","TWN","GBR","USA","ALB","DZA","AGO","ARG","ARM","AZE","BHS","BHR","BRB","BLR","BLZ","BOL","BIH","BWA","BRA","BRN","BGR","CPV","CHL","CHN","COL","CRI","DOM","ECU","EGY","SLV","SWZ","FJI","GAB","GEO","GTM","GUY","HUN","IND","IDN","IRN","IRQ","JAM","JOR","KAZ","KWT","LBN","LBY","MYS","MDV","MUS","MEX","MNG","MNE","MAR","NAM","OMN","PAK","PAN","PRY","PER","PHL","POL","QAT","MKD","ROU","RUS","LCA","VCT","SAU","SRB","SYC","ZAF","LKA","SUR","SYR","THA","TTO","TUN","TUR","UKR","ARE","URY","VEN","AFG","BGD","BEN","BTN","BFA","BDI","KHM","CMR","CAF","TCD","COM","COG","COD","CIV","DJI","ETH","GMB","GHA","GIN","GNB","HTI","HND","KEN","KGZ","LAO","LSO","LBR","MDG","MWI","MLI","MRT","MDA","MOZ","MMR","NPL","NIC","NER","NGA","PNG","RWA","STP","SEN","SLE","SOM","SSD","SDN","TJK","TZA","TLS","TGO","UGA","UZB","VNM","ZMB","ZWE"],"ADVEC":["AUS","AUT","BEL","CAN","HRV","CYP","CZE","DNK","EST","FIN","FRA","DEU","GRC","HKG","ISL","IRL","ISR","ITA","JPN","KOR","LVA","LTU","LUX","MAC","MLT","NLD","NZL","NOR","PRT","PRI","SGP","SVK","SVN","ESP","SWE","CHE","TWN","GBR","USA"],"APQ":["AUS","HKG","JPN","KOR","MAC","NZL","SGP","TWN","BRN","CHN","FJI","IND","IDN","MYS","MDV","MNG","PHL","LKA","THA","BGD","BTN","KHM","LAO","MMR","NPL","PNG","TLS","VNM"],"EUQ":["AUT","BEL","HRV","CYP","CZE","DNK","EST","FIN","FRA","DEU","GRC","ISL","IRL","ISR","ITA","LVA","LTU","LUX","MLT","NLD","NOR","PRT","SVK","SVN","ESP","SWE","CHE","GBR","ALB","BLR","BIH","BGR","HUN","MNE","POL","MKD","ROU","RUS","SRB","TUR","UKR","MDA"],"EURO":["AUT","BEL","HRV","CYP","EST","FIN","FRA","DEU","GRC","IRL","ITA","LVA","LTU","LUX","MLT","NLD","PRT","SVK","SVN","ESP"],"EU":["AUT","BEL","HRV","CYP","CZE","DNK","EST","FIN","FRA","DEU","GRC","IRL","ITA","LVA","LTU","LUX","MLT","NLD","PRT","SVK","SVN","ESP","SWE","BGR","HUN","POL","ROU"],"NMQ":["CAN","USA"],"MAE":["CAN","FRA","DEU","ITA","JPN","GBR","USA"],"WE":["PRI","ARG","BHS","BRB","BLZ","BOL","BRA","CHL","COL","CRI","DOM","ECU","SLV","GTM","GUY","JAM","MEX","PAN","PRY","PER","LCA","VCT","SUR","TTO","URY","VEN","HTI","HND","NIC"],"AS5":["SGP","IDN","MYS","PHL","THA"],"EME":["ALB","DZA","AGO","ARG","ARM","AZE","BHS","BHR","BRB","BLR","BLZ","BOL","BIH","BWA","BRA","BRN","BGR","CPV","CHL","CHN","COL","CRI","DOM","ECU","EGY","SLV","SWZ","FJI","GAB","GEO","GTM","GUY","HUN","IND","IDN","IRN","IRQ","JAM","JOR","KAZ","KWT","LBN","LBY","MYS","MDV","MUS","MEX","MNG","MNE","MAR","NAM","OMN","PAK","PAN","PRY","PER","PHL","POL","QAT","MKD","ROU","RUS","LCA","VCT","SAU","SRB","SYC","ZAF","LKA","SUR","SYR","THA","TTO","TUN","TUR","UKR","ARE","URY","VEN"],"MECA":["DZA","ARM","AZE","BHR","EGY","GEO","IRN","IRQ","JOR","KAZ","KWT","LBN","LBY","MAR","OMN","PAK","QAT","SAU","SYR","TUN","ARE","AFG","DJI","KGZ","MRT","SOM","SDN","TJK","UZB"],"SSQ":["AGO","BWA","CPV","SWZ","GAB","MUS","NAM","SYC","ZAF","BEN","BFA","BDI","CMR","CAF","TCD","COM","COG","COD","CIV","ETH","GMB","GHA","GIN","GNB","KEN","LSO","LBR","MDG","MWI","MLI","MOZ","NER","NGA","RWA","STP","SEN","SLE","SSD","TZA","TGO","UGA","ZMB","ZWE"],"LIC":["AFG","BGD","BEN","BTN","BFA","BDI","KHM","CMR","CAF","TCD","COM","COG","COD","CIV","DJI","ETH","GMB","GHA","GIN","GNB","HTI","HND","KEN","KGZ","LAO","LSO","LBR","MDG","MWI","MLI","MRT","MDA","MOZ","MMR","NPL","NIC","NER","NGA","PNG","RWA","STP","SEN","SLE","SOM","SSD","SDN","TJK","TZA","TLS","TGO","UGA","UZB","VNM","ZMB","ZWE"]}},"FPP":{"order":"7","code":"FPP","caption1":"Public Finances in Modern History","caption2":"Data","indicator":"pb","initchart":"USA,FRA,JPN,GBR,SWE,ESP,ITA,ZAF,IND","intro3":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/FM\" target=\"new\">Fiscal Monitor<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/datamapper\/FPP\/2024OctFiscalMonitorDatabase.xlsx\" target=\"new\">FM Database<\/a>\n","bubbleresize_ind":"d,rev,exp,ie,prim_exp","caption4":"Contact","minyear":"1800","intro1":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/WP\/Issues\/2016\/12\/31\/A-Modern-History-of-Fiscal-Prudence-and-Profligacy-40222\" target=\"new\">IMF Working Paper: \"A Modern History of Fiscal Prudence and Profligacy\"<\/a>\n<a href=\"http:\/\/www.imf.org\/external\/mmedia\/view.aspx?vid=2119566651001\" target=\"new\">Video<\/a>","caption3":"Related links","indicatory":"pb","intro2":"<a href=\"https:\/\/www.imf.org\/external\/datamapper\/FPP\/Public Finances in Modern History Feb 2025.xlsx\" target=\"new\">Full Data in Excel<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/datamapper\/FPP\/Public Finances in Modern History Database.zip\">Full Data in Stata<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/datamapper\/FPP\/Appendix of Data Sources.pdf\" target=\"new\">Appendix of Data Sources<\/a>\n<a href=\"https:\/\/www.imf.org\/external\/datamapper\/FPP\/Public Finances in Modern History Database - IMF Working Paper Version.zip\" target=\"new\">Previous Version<\/a>\n","intro4":"Send comments and questions about the Public Finances in Modern History database to <u><a href=\"mailto:historicalpubfin@imf.org\">historicalpubfin@imf.org<\/a><\/u>.","description":"The Public Finances in Modern History Database documents two-hundred years of the history of budget deficits and government debts. The current version covers 151 countries over the period 1800 - 2023, subject to data availability. These data were assembled from a wide array of historical sources, which are documented in the Appendix of Data Sources. The initial database, which covered 55 countries, was analyzed in \"A Modern History of Fiscal Prudence and Profligacy\", <i>Journal of Monetary Economics<\/i>, 2015, Vol. 76, pp. 55 - 70, by Paolo Mauro, Rafael Romeu, Ariel Binder, and Asad Zaman.\n\nA distinguishing feature of the database is the presence of primary balance data, which is the difference between a government's revenues and its non-interest expenditures, alongside the corresponding government debt data. The primary balance is the most accurate reflection of government fiscal policy decisions. We invite you to explore these data through the interactive graphs below and take in a glimpse of the history of deficits and debts around the world.\n\nWe welcome citations to the source of the data and comments on the data to historicalpubfin@imf.org.","maparea":"FAD_WORLD","maxyear":"2023","indicatorx":"rgc","version":"Public Finances in Modern History Database - Feb 2025","title":"Public Finances in Modern History","numcountries":144,"geoitems":["ABW","AGO","ALB","ARE","ARG","ATG","AUS","AUT","AZE","BDI","BEL","BEN","BFA","BGD","BGR","BHR","BHS","BLZ","BOL","BRA","BRB","BTN","CAF","CAN","CHE","CHL","CHN","CIV","COG","COL","COM","CPV","CRI","CYP","CZE","DEU","DJI","DMA","DNK","DOM","DZA","ECU","ESP","EST","ETH","FIN","FJI","FRA","FSM","GAB","GBR","GEO","GHA","GIN","GNB","GNQ","GRC","GRD","GTM","GUY","HKG","HND","HRV","HTI","HUN","IDN","IND","IRL","IRN","ISL","ISR","ITA","JAM","JOR","JPN","KEN","KGZ","KHM","KIR","KNA","KOR","KWT","LBN","LCA","LKA","LSO","LUX","MAR","MDA","MDG","MDV","MEX","MHL","MKD","MNG","MYS","NAM","NER","NGA","NIC","NLD","NOR","NZL","OMN","PAK","PAN","PER","PHL","PNG","POL","PRT","PRY","QAT","ROU","RUS","RWA","SAU","SDN","SEN","SLB","SLV","SUR","SVK","SVN","SWE","SWZ","SYC","TCD","TGO","THA","TTO","TUN","TUR","TZA","UGA","UKR","URY","USA","UZB","VCT","VEN","VUT","YEM","ZAF"],"regions":{"FAD_WORLD":["ABW","AGO","ALB","ARE","ARG","ATG","AUS","AUT","AZE","BDI","BEL","BEN","BFA","BGD","BGR","BHR","BHS","BLZ","BOL","BRA","BRB","BTN","CAF","CAN","CHE","CHL","CHN","CIV","COG","COL","COM","CPV","CRI","CYP","CZE","DEU","DJI","DMA","DNK","DOM","DZA","ECU","ESP","EST","ETH","FIN","FJI","FRA","FSM","GAB","GBR","GEO","GHA","GIN","GNB","GNQ","GRC","GRD","GTM","GUY","HKG","HND","HRV","HTI","HUN","IDN","IND","IRL","IRN","ISL","ISR","ITA","JAM","JOR","JPN","KEN","KGZ","KHM","KIR","KNA","KOR","KWT","LBN","LCA","LKA","LSO","LUX","MAR","MDA","MDG","MDV","MEX","MHL","MKD","MNG","MYS","NAM","NER","NGA","NIC","NLD","NOR","NZL","OMN","PAK","PAN","PER","PHL","PNG","POL","PRT","PR