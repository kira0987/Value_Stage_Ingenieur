L","PRT","ROU","SVK","SVN","SWE"],"SAQ":["BGD","BTN","IND","LKA","MDV","NPL","PAK"],"DA":["BGD","BRN","BTN","CHN","FJI","FSM","IDN","IND","KHM","KIR","LAO","LKA","MDV","MHL","MKD","MMR","MNG","MYS","NPL","PHL","PLW","PNG","SLB","THA","TLS","TON","TUV","VNM","VUT","WSM"],"CMQ":["BLZ","CRI","GTM","HND","NIC","PAN","SLV"],"SEQ":["BRN","IDN","KHM","LAO","MMR","MYS","PHL","SGP","THA","TLS","VNM"],"NMQ":["CAN","MEX","USA"],"MAE":["CAN","DEU","FRA","GBR","ITA","JPN","USA"],"EAQ":["CHN","HKG","JPN","KOR","MNG","TWN"],"NAQ":["DZA","EGY","LBY","MAR","TUN"],"PIQ":["FJI","FSM","KIR","MHL","PLW","PNG","SLB","TON","TUV","VUT","WSM"],"AS5":["IDN","MYS","PHL","THA","VNM"]},"hierarchies":{"indicators":{"1":{"indicators":["extensive","intensive","total_theil"],"label":"Export Diversification"},"2":{"indicators":["SITC1_0","SITC1_1","SITC1_2","SITC1_3","SITC1_4","SITC1_5","SITC1_6","SITC1_7","SITC1_8","SITC1_9","SITC1_total"],"label":"Export Quality Index"}},"groups":{"1":"WEOWORLD","2":{"code":"ADVEC","groups":{"1":"EURO","2":"MAE","4":"OAE"}},"3":"EU","4":{"code":"OEMDC","groups":{"1":"CIS","2":{"code":"DA","groups":{"1":"AS5"}},"3":"EDE","4":"WE","5":{"code":"MENAP","groups":{"1":"MENA"}},"6":"SSA"}}},"regions":{"5":{"code":"AFQ","regions":{"1":"NAQ","2":"SSQ"}},"6":{"code":"APQ","regions":{"1":"AZQ","2":"CAQ","3":"EAQ","4":"PIQ","5":"SAQ","6":"SEQ"}},"7":{"code":"EUQ","regions":{"1":"EEQ","2":"WEQ"}},"8":"MEQ","9":{"code":"WHQ","regions":{"1":"CBQ","2":"CMQ","3":"NMQ","4":"SMQ"}}}}},"CL":{"code":"CL","order":"13","bubbleresize_ind":"LP,NGDPD","intro1":"<a href=\"https:\/\/www.imf.org\/external\/pubs\/cat\/longres.aspx?sk=42876.0\" target=\"new\">Non-FDI Capital Inflows<\/a>\r\n<a href=\"http:\/\/itunes.apple.com\/us\/app\/imf-news-and-data-for-the-ipad\/id414587764?mt=8\" target=\"new\">Also available on iPad<\/a>","caption1":"Links to Research Paper","indicator":"Ka_new","indicatorx":"NGDPD","caption4":"Feedback","initchart":"SPR_HIC,SPR_LIDC,SPR_FLIDC","description":"The Wang-Jahan capital account openness index is a de jure index that provides information on the state of openness of the capital account based on 12 types of asset categories for 168 countries, of which 60 are low-income developing countries, over the period 1996 -2013. This index is constructed based on the information contained in the IMF\u2019s Annual Report on Exchange Arrangements and Exchange Restrictions (AREAER). It not only captures the overall openness of the capital account but also provides a breakdown of openness across various types of subcategories: direction of flows (inflow verses outflow), residency (resident verses non-resident), and asset types (for example, equity, bonds, direct investment etc.). The granularity of this index provides researchers and policy-makers new avenues to pinpoint changes in de jure policies with associated changes in de facto capital flows. The large country coverage, particularly of low-income developing countries, allows for an in-depth analysis of each individual country or cross-country comparisons.","intro3":"<a href=\"http:\/\/www.imf.org\/external\/np\/pp\/eng\/2014\/060314.pdf\" target=\"new\">LIC Country Group Classifications<\/a>","maparea":"CFWORLD","caption2":"Dataset","indicatory":"LP","minyear":"2000","intro2":"<a href=\"http:\/\/www.imf.org\/external\/datamapper\/LB_data.xlsx\" target=\"new\">Full Data<\/a>","title":"Capital Account Openness Index (April 2016)","sdmx_geoitem ":"REF_AREA","sdmx_freq ":"FREQ","projectionyear":"2014","caption3":"Methodology","intro4":"Send comments and questions to the <div><a href=\"mailto:CF_in_LICs@imf.org\"><u>Liberalization Data<\/u><\/a><\/div> <br>\r\n\r\nSend us your comments about <div>\r\n<a href=\"mailto:DataMapper@imf.org\"><u>DataMapper Tool<\/u><\/a><\/div> <br>","maxyear":"2013","version":"Capital Account Liberalization Index (April 2016)","hierarchies":{"indicators":{"1":{"indicators":["ka_new","ka_in","ka_out","FM_ka","Nonres_ka","Res_ka"],"label":"Aggregate Openness 