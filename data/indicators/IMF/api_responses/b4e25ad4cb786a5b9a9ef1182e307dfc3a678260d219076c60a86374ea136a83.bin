d7da","min":"0"}],"unit":"Annual percent change","stackable":"0","description":"Gross domestic product is the most commonly used single measure of a country's overall economic activity. It represents the total value at constant prices of final goods and services produced within a country during a specified time period, such as one year.","label":"Real GDP growth","source":"World Economic Outlook (April 2025)","mapinfo":"EN"},"NGDPD":{"dataset":"WEO","group":"1","label":"GDP, current prices","legend":[{"label":"500 or more","color":"#cc660b","min":"500","max":"150000"},{"color":"#d48639","min":"100","label":"100 - 500","max":"500"},{"max":"100","label":"25 - 100","min":"25","color":"#e1a365"},{"label":"5 - 25","color":"#B7CCA3","max":"25","min":"5"},{"color":"#97AF7D","max":"5","label":"under 5","min":"0"},{"min":"0","label":"no data","max":"0","color":"#d5d7da"}],"description":"Gross domestic product is the most commonly used single measure of a country's overall economic activity. It represents the total value at current prices of final goods and services produced within a country during a specified time period, such as one year.","mapinfo":"EN","datasource":"\/external\/datamapper\/api\/index.php?values=NGDPD","stackable":"1","source":"World Economic Outlook (April 2025)","unit":"Billions of U.S. dollars"},"NGDPDPC":{"dataset":"WEO","group":"1","unit":"U.S. dollars per capita","label":"GDP per capita, current prices\n","datasource":"\/external\/datamapper\/api\/index.php?values=NGDPDPC","legend":[{"max":"1000000","min":"25000","color":"#46a7af","label":"25,000 or more"},{"color":"#9cd1bb","label":"10,000 - 25,000","min":"10000","max":"25000"},{"label":"2,500 - 10,000","max":"10000","color":"#f2bc8f","min":"2500"},{"color":"#d66a22","label":"500 - 2,500","min":"500","max":"2500"},{"color":"#bc2d18","label":"under 500","min":"0","max":"500"},{"min":"0","label":"no data","color":"#d5d7da","max":"0"}],"mapinfo":"EN","description":"Gross domestic product is the most commonly used single measure of a country's overall economic activity. It represents the total value at current prices of final goods and services produced within a country during a specified time period divided by the average population for the same one year.","stackable":"0","source":"World Economic Outlook (April 2025)"},"PPPGDP":{"dataset":"WEO","group":"1","legend":[{"min":"1000","max":"250000","color":"#cc660b","label":"1000 or more"},{"min":"250","color":"#d48639","max":"1000","label":"250 - 1000"},{"max":"250","min":"100","color":"#e1a365","label":"100 - 250"},{"max":"100","color":"#B7CCA3","min":"10","label":"10 - 100"},{"color":"#97AF7D","max":"10","label":"under 10","min":"0"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"label":"GDP, current prices","description":"Gross domestic product is the most commonly used single measure of a country's overall economic activity. It represents the total value in PPP terms of final goods and services produced within a country during a specified time period.\n\nPurchasing Power Parity (PPP) is a theory which relates changes in the nominal exchange rate between two countries currencies to changes in the countries' price levels. More information on PPP methodology can be found on the World Economic Outlook FAQ - <a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/weo\/faq.htm#q4d\" target=\"new\">click here<\/a>","source":"World Economic Outlook (April 2025)","datasource":"\/external\/datamapper\/api\/index.php?values=PPPGDP","unit":"Purchasing power parity; billions of international dollars","mapinfo":"EN","stackable":"1"},"PPPPC":{"dataset":"WEO","group":"1","source":"World Economic Outlook (April 2025)","legend":[{"color":"#46a7af","min":"25000","max":"200000","label":"25,000 or more"},{"color":"#9cd1bb","label":"15,000 - 25,000","min":"15000","max":"25000"},{"label":"5,000 - 15,000","max":"15000","min":"5000","color":"#f2bc8f"},{"max":"5000","min":"1000","color":"#d66a22","label":"1,000 - 5,000"},{"label":"under 1,000","max":"1000","color":"#bc2d18","min":"0"},{"label":"no data","min":"0","max":"0","color":"#d5d7da"}],"label":"GDP per capita, current prices","datasource":"\/external\/datamapper\/api\/index.php?values=PPPPC","description":"Gross domestic product (GDP) is the most commonly used single measure of a country's overall economic activity. Per capita GDP represents the total value in PPP terms of final goods and services produced within a country during a specified time period divided by the average population for the same one year.\n\nPurchasing Power Parity (PPP) is a theory which relates changes in the nominal exchange rate between two countries currencies to changes in the countries' price levels. More information on PPP methodology can be found on the World Economic Outlook FAQ - <a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/weo\/faq.htm#q4d\" target=\"new\">click here<\/a>","unit":"Purchasing power parity; international dollars per capita","stackable":"0","mapinfo":"EN"},"PPPSH":{"group":"1","dataset":"WEO","legend":[{"color":"#cc660b","label":"Greater than 3%","min":"3","max":"80"},{"label":"1% - 3%","min":"1","max":"3","color":"#d48639"},{"max":"1","label":"0.5% - 1%","min":"0.5","color":"#e1a365"},{"min":"0.1","max":"0.5","label":"0.1% - 0.5%","color":"#B7CCA3"},{"color":"#97AF7D","label":"Less than 0.1%","max":"0.1","min":"0"},{"min":"0","label":"no data","max":"0","color":"#d5d7da"}],"description":"Purchasing Power Parity (PPP) weights are individual countries' share of total World gross domestic product at purchasing power parities.\n\nPurchasing Power Parity (PPP) is a theory which relates changes in the nominal exchange rate between two countries currencies to changes in the countries' price levels. More information on PPP methodology can be found on the World Economic Outlook FAQ - <a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/weo\/faq.htm#q4d\" target=\"new\">click here<\/a>","datasource":"\/external\/datamapper\/api\/index.php?values=PPPSH","label":"GDP based on PPP, share of world","mapinfo":"EN","unit":"Percent of World","source":"World Economic Outlook (April 2025)","stackable":"1"},"PPPEX":{"dataset":"WEO","group":"1","legend":[{"color":"#cc660b","max":"150000","label":"500 or more","min":"500"},{"max":"500","label":"50 - 500","color":"#d48639","min":"50"},{"color":"#e1a365","max":"50","min":"5","label":"5 - 50"},{"min":"1","label":"1 - 5","max":"5","color":"#B7CCA3"},{"color":"#97AF7D","max":"1","label":"under 1","min":"0"},{"color":"#d5d7da","label":"no data","min":"0","max":"0"}],"description":"Purchasing Power Parity (PPP) is a theory which relates changes in the nominal exchange rate between two countries currencies to changes in the countries' price levels. More information on PPP methodology can be found on the World Economic Outlook FAQ - <a href=\"http:\/\/www.imf.org\/external\/pubs\/ft\/weo\/faq.htm#q4d\" target=\"new\">click here<\/a>","label":"Implied PPP conversion rate","datasource":"\/external\/datamapper\/api\/index.php?values=PPPEX","mapinfo":"EN","stackable":"0","source":"World Economic Outlook (April 2025)","unit":"National currency per international dollar"},"PCPIPCH":{"dataset":"WEO","group":"2","datasource":"\/external\/datamapper\/api\/index.php?values=PCPIPCH","legend":[{"color":"#cc660b","min":"25","max":"100000","label":"25% or more"},{"color":"#d48639","label":"10% - 25%","max":"25","min":"10"},{"max":"10","label":"3% - 10%","color":"#e1a365","min":"3"},{"max":"3","color":"#B7CCA3","min":"0","label":"0% - 3%"},{"max":"0","min":"-100","color":"#97AF7D","label":"less than 0%"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"description":"The average consumer price index (CPI) is a measure of a country's average level of prices based on the cost of a typical basket of consumer goods and services in a given period. The rate of inflation is the percent change in the average CPI.\n \n","label":"Inflation rate, average consumer prices","mapinfo":"EN","source":"World Economic Outlook (April 2025)","stackable":"0","unit":"Annual percent change"},"PCPIEPCH":{"group":"2","dataset":"WEO","unit":"Annual percent change","label":"Inflation rate, end of period consumer prices","legend":[{"label":"25% or more","max":"1000000","color":"#cc660b","min":"25"},{"color":"#d48639","max":"25","label":"10% - 25%","min":"10"},{"color":"#e1a365","label":"3% - 10%","max":"10","min":"3"},{"label":"0% - 3%","max":"3","min":"0","color":"#B7CCA3"},{"color":"#97AF7D","max":"0","min":"-100","label":"less than 0%"},{"min":"0","label":"no data","color":"#d5d7da","max":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=PCPIEPCH","description":"The end of period consumer price index (CPI) is a measure of a country's general level of prices based on the cost of a typical basket of consumer goods and services at the end of a given period. The rate of inflation is the percent change in the end of period CPI.\n \n","mapinfo":"EN","stackable":"0","source":"World Economic Outlook (April 2025)"},"LP":{"dataset":"WEO","group":"3","source":"World Economic Outlook (April 2025)","legend":[{"min":"200","label":"200 or more","max":"10000","color":"#cc660b"},{"min":"25","color":"#d48639","max":"200","label":"25 - 200"},{"min":"5","label":"5 - 25","color":"#e1a365","max":"25"},{"color":"#B7CCA3","label":"1 - 5","max":"5","min":"1"},{"max":"1","color":"#97AF7D","min":"0","label":"Less than 1"},{"max":"0","color":"#d5d7da","label":"no data","min":"0"}],"label":"Population","datasource":"\/external\/datamapper\/api\/index.php?values=LP","unit":"Millions of people","mapinfo":"EN","description":"Total population of a country, region, or group of countries.","stackable":"1"},"BCA":{"group":"4","dataset":"WEO","source":"World Economic Outlook (April 2025)","description":"The current account is the record of all transactions in the balance of payments covering the exports and imports of goods and services, payments of income, and current transfers between residents of a country and nonresidents.","datasource":"\/external\/datamapper\/api\/index.php?values=BCA","label":"Current account balance\nU.S. dollars","unit":"Billions of U.S. dollars","mapinfo":"EN","decimalrounding":"3","legend":[{"color":"#cc660b","label":"50 or more","max":"1000","min":"50"},{"min":"10","color":"#d48639","max":"50","label":"10 - 50"},{"min":"0","color":"#e1a365","label":"0 - 10","max":"10"},{"min":"-50","color":"#B7CCA3","label":"-50 - 0","max":"0"},{"min":"-1500","label":"less than -50","color":"#97AF7D","max":"-50"},{"max":"0","label":"no data","min":"0","color":"#d5d7da"}],"stackable":"1"},"BCA_NGDPD":{"dataset":"WEO","group":"4","datasource":"\/external\/datamapper\/api\/index.php?values=BCA_NGDPD","mapinfo":"EN","description":"The current account is the record of all transactions in the balance of payments covering the exports and imports of goods and services, payments of income, and current transfers between residents of a country and nonresidents.","label":"Current account balance, percent of GDP","legend":[{"max":"500","color":"#cc660b","label":"10% or more","min":"10"},{"color":"#d48639","max":"10","label":"5% - 10%","min":"5"},{"label":"0% - 5%","min":"0","color":"#e1a365","max":"5"},{"label":"-5% - 0%","min":"-5","color":"#B7CCA3","max":"0"},{"label":"less than -5%","max":"-5","min":"-300","color":"#97AF7D"},{"max":"0","label":"no data","color":"#d5d7da","min":"0"}],"source":"World Economic Outlook (April 2025)","stackable":"0","unit":"Percent of GDP"},"":{"mapinfo":"EN"},"LUR":{"group":"3","dataset":"WEO","source":"World Economic Outlook (April 2025)","legend":[{"min":"20","label":"20% or more","color":"#cc660b","max":"100"},{"color":"#d48639","min":"15","label":"15% - 20%","max":"20"},{"label":"10% - 15%","color":"#e1a365","min":"10","max":"15"},{"max":"10","color":"#B7CCA3","min":"5","label":"5% - 10%"},{"label":"Less than 5%","color":"#97AF7D","min":"0","max":"5"},{"color":"#d5d7da","label":"no data","max":"0","min":"0"}],"description":"The number of unemployed persons as a percentage of the total labor force.","datasource":"\/external\/datamapper\/api\/index.php?values=LUR","label":"Unemployment rate","stackable":"0","mapinfo":"EN","unit":"Percent"},"GGXCNL_NGDP":{"dataset":"WEO","group":"5","mapinfo":"EN","datasource":"\/external\/datamapper\/api\/index.php?values=GGXCNL_NGDP","description":"Net lending (+)\/ borrowing (\u0096) is calculated as revenue minus total expenditure. This is a core GFS balance that measures the extent to which general government is either putting financial resources at the disposal of other sectors in the economy and nonresidents (net lending), or utilizing the financial resources generated by other sectors and nonresidents (net borrowing). This balance may be viewed as an indicator of the financial impact of general government activity on the rest of the economy and nonresidents (GFSM 2001, paragraph 4.17). Note: Net lending (+)\/borrowing (\u0096) is also equal to net acquisition of financial assets minus net incurrence of liabilities.","legend":[{"label":"10% or more","min":"10","color":"#cc660b","max":"200"},{"min":"3","label":"3% - 10%","color":"#d48639","max":"10"},{"label":"-3% - 3%","max":"3","color":"#e1a365","min":"-3"},{"max":"-3","min":"-10","color":"#B7CCA3","label":"-10% - -3%"},{"color":"#97AF7D","min":"-1000","max":"-10","label":"Less than -10%"},{"label":"no data","color":"#d5d7da","min":"0","max":"0"}],"label":"General government net lending\/borrowing","stackable":"0","unit":"Percent of GDP","source":"World Economic Outlook (April 2025)"},"GGXWDG_NGDP":{"dataset":"WEO","group":"5","legend":[{"max":"800","color":"#cc660b","label":"100% or more","min":"100"},{"max":"100","label":"75% - 100%","min":"75","color":"#d48639"},{"color":"#e1a365","max":"75","label":"50% - 75%","min":"50"},{"max":"50","color":"#B7CCA3","min":"25","label":"25% - 50%"},{"max":"25","min":"0","color":"#97AF7D","label":"Less than 25%"},{"max":"0","min":"0","color":"#d5d7da","label":"no data"}],"datasource":"\/external\/datamapper\/api\/index.php?values=GGXWDG_NGDP","unit":"Percent of GDP","source":"World Economic Outlook (April 2025)","label":"General government gross debt","stackable":"0","description":"Gross debt consists of all liabilities that require payment or payments of interest and\/or principal by the debtor to the creditor at a date or dates in the future. This includes debt liabilities in the form of SDRs, currency and deposits, debt securities, loans, insurance, pensions and standardized guarantee schemes, and other accounts payable. Thus, all liabilities in the GFSM 2001 system are debt, except for equity and investment fund shares and financial derivatives and employee stock options. Debt can be valued at current market, nominal, or face values (GFSM 2001, paragraph 7.110).","mapinfo":"EN"},"rev":{"group":"1","dataset":"FPP","legend":[{"max":"1000","label":"40 or more","min":"40","color":"#670203"},{"max":"40","min":"30","color":"#a1584e","label":"30 - 40"},{"color":"#ef9070","min":"20","max":"30","label":"20 - 30"},{"max":"20","color":"#fad07d","label":"10 - 20","min":"10"},{"min":"0","label":"0 - 10","max":"10","color":"#ffffcc"},{"label":"no data","color":"#d5d7da","max":"0","min":"0"}],"datasource":"\/external\/datamapper\/api\/index.php?values=rev","source":"Public Finances in Modern History Database (Feb 2025)","description":"Government revenue, percent of GDP","label":"Government revenue, percent of GDP","mapinfo":"EN","unit":"% of GDP","stackable":"0"},"exp":{"dataset":"FPP","group":"1","mapinfo":"EN","unit":"% of GDP","label":"Government expenditure, percent of GDP","legend":[{"max":"1000","color":"#670203","min":"40","label":"40 or more"},{"color":"#a1584e","max":"40","label":"30 - 40","min":"30"},{"color":"#ef9070","min":"20","label":"20 - 30","max":"30"},{"label":"10 - 20","min":"10","max":"20","color":"#fad07d"},{"max":"10","color":"#ffffcc","label":"0 - 10","min":"0"},{"max":"0","color":"#d5d7da","l