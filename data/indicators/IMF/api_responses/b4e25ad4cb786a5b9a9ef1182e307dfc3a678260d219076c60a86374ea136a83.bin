election","png":".PNG image","minmax":"min\/max","profileintro":"<p>Please select a country, region or group listed below or use the search button above to view country\/region\/group specific data profile.<\/p>","selectyear":"Year","stop":"Stop","reset":"Reset","select":"Select","selectoutput":"Select a format to output","population":"Population  (Millions of PL)","month5":"May","profiles":"Select a country, region or group","skewright":"Skewed right","subject":"Subject","selectdbhelp":"Select a dataset. Select subjects within that dataset using the buttons on the axes of the bubble chart.","selectdb":"Select a dataset","selectsubject":"Select subject","profileheader":"Country Data Profile","month6":"Jun","quarter3":"3rd","stackhelp":"Stack bar","quarter2":"2nd","selection":"Selected Items","selectindicator":"Select an indicator","selectsubjhelp":"Select a subject. Every dataset holds multiple subjects within categories.","regularmap":"regular map","more":"More","relatedcountrypages":"Related country pages","trillion":" trillion","rerank":"Rank","selectregions":"Show regions or analytical groups","showbubblelabels":"Show\/hide country Labels","showmap":"Show map","save_image":"Save image","noneselected":"none selected","savecurrentsettings":"Save current settings","upto":"Up to","selecteddata":"Selected Country Data","settings":"Settings","title":"IMF Data Mapper \u00ae","thousand":" thousand","share":"Share","quarter4":"4th","selectcolor":"Select a color","showbellcurve":"Show bell curve","sizevars":"Set size variable to:","regions":"Regions","value":"Value","showoutliers":"Show outliers","skewleft":"Skewed left","relatedpublications":"Related publications","source":"Source:","skew":"Skew","thankyou":"Thank you!","selectcountry":"Select a country, region or group for chart","visibilityall":"all","subjects":"Subjects","warning":"Warning","showall":"Show all","visibility":"Visibility","thoussep":",","showtrails":"Show trails","top10":"Top 10","timerange":"Time range","useourdata":"Use our data","visibility10":"10-90%","visibility25":"25-75%","year":"year","code":"1.4.4","geoitem":"354801","parent":"418444"},"datasets":{"WEO":{"code":"WEO","order":"1","bubbleresize_ind":"LP,NGDPD","indicator":"NGDP_RPCH","caption4":"Feedback","description":"This version of the IMF Data Mapper contains only selected key indicators from the World Economic Outlook (WEO). The WEO publication is available in full on the IMF's website, www.imf.org. Accompanying it on the website is a larger compilation of data from the WEO database than is included in the IMF Data Mapper.\n\nThe data appearing in the World Economic Outlook (WEO) are compiled by the IMF staff at the time of the WEO exercises. The historical data and projections are based on the information gathered by the IMF country desk officers in the context of their missions to IMF member countries and through their ongoing analysis of the evolving situation in each country. Historical data are updated on a continual basis, as more information becomes available, and structural breaks in data are often adjusted to produce smooth series with the use of splicing and other techniques. IMF staff estimates continue to serve as proxies for historical series when complete information is unavailable. As a result, WEO data can differ from other sources with official data, including the IMF's International Financial Statistics. \n\nThe WEO data and metadata provided are \"as is\" and \"as available,\" and every effort is made to ensure, but not guarantee, their timeliness, accuracy, and completeness. When errors are discovered, there is a concerted effort to correct them as appropriate and feasible. For details on the terms and conditions for usage of the WEO database, please refer to the IMF Copyright and Usage website, http:\/\/www.imf.org\/external\/terms.htm.\n","group1":"Gross domestic product indicators","caption3":"Methodology","caption1":"World Economic Outlook","maparea":"WEOWORLD","group3":"Population and unemployment rate","intro4":"Send us your comments about <div><a href=\"mailto:DataMapper@imf.org\"><u>DataMapper Tool<\/u><\/a><\/div> <br>\nSend comments and questions about<div>WEO data to: <a href=\"http:\/\/forums.imf.org\" target=\"new\"><u>WEO Data Question<\/u><\/a><\/div> <br>\nFor all other questions, <div>go to: <a href=\"http:\/\/www.imf.org\/en\/Data\" target=\"new\"><u> IMF Data page<\/u> <\/a><div>","title":"World Economic Outlook (April 2025)","group2":"Inflation rate","group5":"Government finance indicators","indicatorx":"NGDPD","caption2":"WEO Database","minyear":"1980","initchart":"OEMDC,ADVEC,WEOWORLD","sdmx_geoitem ":"REF_AREA","intro1":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/WEO\/Issues\/2025\/04\/22\/world-economic-outlook-april-2025\" target=\"new\">Current Report<\/a>\n<a href=\"https:\/\/www.bookstore.imf.org\/books\/world-economic-outlook-april-2025\">Order print subscription<\/a>\n<a href=\"https:\/\/www.imf.org\/en\/publications\/weo\" target=\"new\">Earlier Reports<\/a>\n","group4":"Current account indicators","indicatory":"LP","sdmx_freq ":"FREQ","intro3":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/WEO\/weo-database\/2025\/April\/groups-and-aggregates\" target=\"new\">Analytical Groups<\/a>\n<a href=\"http:\/\/www.imf.org\/external\/datamapper\/region.htm\" target=\"new\">Regional Groups<\/a>","projectionyear":"2025","intro2":"<a href=\"https:\/\/www.imf.org\/en\/Publications\/WEO\/weo-database\/2025\/April\/select-country-group\" target=\"new\">Country Data<\/a>\n<a href=\"https:\/\/www.imf.org\/en\/Publications\/WEO\/weo-database\/2025\/April\/select-aggr-data\" target=\"new\">Analytical Group Data<\/a>\n<a href=\"https:\/\/www.imf.org\/en\/Publications\/WEO\/weo-database\/2025\/April\/download-entire-database\" target=\"new\">Entire WEO Dataset<\/a>","maxyear":"2030","version":"World Economic Outlook - April 2025","numcountries":237,"geoitems":["ABW","AIA","ASM","BGD","COD","COG","COK","DNK","DOM","DZA",